#!/usr/bin/env bash
set -euo pipefail

[ -f "$REPO_DIR/file-paths" ]

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
user_level=false; [ "$script_dir" == "/etc/scripts" ] || user_level=true

if $user_level; then
  # shellcheck disable=SC1091
  source "$REPO_DIR/file-paths"
else
  # shellcheck disable=SC1091
  source /etc/file-paths
fi

if [ ${#HOME_PATHS[@]} != ${#SYSTEM_HOME_PATHS[@]} ]; then
  echo "TABLICE MAJA ROZNE DLUGOSCI!"; exit 1
fi

for ((i = 0; i < ${#HOME_PATHS[@]}; i++)); do
  /etc/scripts/compare-files "${SYSTEM_HOME_PATHS[$i]}" "${HOME_PATHS[$i]}.etc" "copy-config-to-home" || :
done

exit 0
