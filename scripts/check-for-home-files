#!/usr/bin/env bash

source /etc/file-paths || exit 1

if [ "${#HOME_PATHS[@]}" != "${#SYSTEM_HOME_PATHS[@]}" ]; then
  echo
  echo "TABLICE MAJA ROZNE DLUGOSCI!"
  echo
else
  for ((i = 0; i < ${#HOME_PATHS[@]}; i++)); do
    /etc/scripts/compare-files ${SYSTEM_HOME_PATHS[$i]} ${HOME_PATHS[$i]}.etc "copy-config-to-home"
  done
fi
