#!/usr/bin/env bash
set -euo pipefail

[ -f "$REPO_DIR/file-paths" ]

# shellcheck disable=SC1091
source /etc/file-paths || exit 1

if [ ${#REPO_ROOT_PATHS[@]} != ${#SYSTEM_ROOT_PATHS[@]} ] || [ ${#REPO_HOME_PATHS[@]} != ${#SYSTEM_HOME_PATHS[@]} ]; then
  echo "TABLICE MAJA ROZNE DLUGOSCI!"; exit 1
fi

for ((i = 0; i < ${#REPO_ROOT_PATHS[@]}; i++)); do
  /etc/scripts/compare-files "${REPO_ROOT_PATHS[$i]}"    "${SYSTEM_ROOT_PATHS[$i]}"    "copy-config-to-system" || :
done

for ((i = 0; i < ${#REPO_HOME_PATHS[@]}; i++)); do
  /etc/scripts/compare-files "${REPO_HOME_PATHS[$i]}"    "${SYSTEM_HOME_PATHS[$i]}"    "copy-config-to-system" || :
done

exit 0
