#!/usr/bin/env bash
set -euo pipefail

[ "$(whoami)" != "$REPO_USER" ] && exit 0
command -v git 1>/dev/null || exit 0

plik_z_data="$REPO_DIR/.gitupdate"
data_z_pliku=$(cat "$plik_z_data" 2>/dev/null || echo "")
data_aktualna=$(date +%F)

[ "$data_z_pliku" == "$data_aktualna" ] && exit 0

cd "$REPO_DIR" || exit 1
echo "git pull ..."
git pull && echo "$data_aktualna" > "$plik_z_data"

exit 0
