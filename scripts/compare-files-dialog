#!/usr/bin/env bash

header() {
  printf "╭%81s┬%25s╮\n" "" "" | sed "s/ /─/g"
  printf "│ %-58s ──► %16s │ Dest. props        Info │\n" "Source file" "Destination file"
  printf "├%81s┼%25s┤\n" "" "" | sed "s/ /─/g"
}

user-input() {
  printf "${reset} ${kolor}"
  read odpowiedz
  odpowiedz="${odpowiedz,,}"
}

plik_zrodlowy="${1/#$HOME/\~}"
plik_docelowy="${2/#$HOME/\~}"
uprawnienia_pliku_docelowego=$(ls -l "$2" 2>/dev/null | awk '{print $1, $3, $4}')
(("${3:0}" % 2)) && kolor="\033[0m" || kolor="\033[38;5;111m"
czerwony="\e[1;31m"
reset="\033[0m"
line1_column1=$(printf "│ %-74s%5s" "$plik_zrodlowy" "$(( $3 + 1 ))/$4")
props1=$(echo "$uprawnienia_pliku_docelowego" | awk '{print $2}')
props2=$(echo "$uprawnienia_pliku_docelowego" | awk '{print $3}')
line2_column1=$(
  (( "$3" + 1 == "$4" )) && printf "╰" || printf "├"
  printf "%$((78 - ${#plik_docelowy}))s" "" | sed "s/ /─/g"
  printf "► %s" "$plik_docelowy"
)
props3=$(echo "$uprawnienia_pliku_docelowego" | awk '{print $1}')

[ "$3" == 0 ] && header

printf "${kolor}"
printf "%s │ %-19s " "$line1_column1" "$props1 $props2"
line2=$(printf "%s │ %-13s" "$line2_column1" "$props3")
if /etc/scripts/compare-files "$1" "$2" ""; then
  $5 && read_hint="[copy/y/N]"
  printf "%s\n" "1=2 │"
  printf "$line2"
  printf "%10s" "$read_hint"
  printf " │"

  if $5; then user-input; else printf "\n"; fi
else
  read_hint="[copy/y/N]"
  printf "${czerwony}"
  [ -f "$1" ] && ([ -f "$2" ] && printf "%s" "1≠2" || printf "%s" "2∈Ø") || printf "%s" "1∈Ø"
  printf "${reset}${kolor}"
  printf " │\n"
  printf "$line2"
  printf "${czerwony}"
  printf "%10s" "$read_hint"
  printf "${kolor}"
  printf " │"

  user-input
fi
printf "${reset}"

[ "$odpowiedz" == "y" ] && exit 1
[ "$odpowiedz" == "copy" ] && exit 2

exit 0
