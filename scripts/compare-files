#!/usr/bin/env bash

hash1=$(sha256sum "$1" 2>/dev/null | awk '{print $1}') &&
hash2=$(sha256sum "$2" 2>/dev/null | awk '{print $1}') &&

if [ "$hash1" != "$hash2" ]; then
  if [ "$3" != "" ]; then
    echo "--------------------------------------------------"
    echo "|                                                |"
    echo "|          Pliki sa rozne lub ich brak!          |"; [ "$3" == "copy-config-to-home" ] &&
    echo "|    Uruchom polecenie 'copy-config-to-home'!    |"; [ "$3" == "copy-config-to-system" ] &&
    echo "|   Uruchom polecenie 'copy-config-to-system'!   |"
    echo "|                                                |"
    echo "--------------------------------------------------"

    printf "%-47s -> %-45s\n\n" "$1" "$2"
  fi

  exit 1
fi

exit 0
