#!/usr/bin/env bash

INSPECT=false
while getopts "i" flaga; do
  case "${flaga}" in
    i)
      INSPECT=true
      ;;
  esac
done
shift $((OPTIND - 1))

user_input() {
  printf "${RESET} ${KOLOR}"
  read odpowiedz
  odpowiedz="${odpowiedz,,}"
}

uprawnienia_pliku_docelowego="$(ls -l $2 2>/dev/null | awk '{print $1, $3, $4}')"
((${3:0} % 2)) && KOLOR="\033[0m" || KOLOR="\033[38;5;153m"
RESET="\033[0m"

ile_kresek=$((120 - ${#2} - 3))
printf "${KOLOR}"
line1_1=$(printf "│%-114s%5s" "$1" "$(( $3 + 1 ))/$4")
line1_2=$(echo $uprawnienia_pliku_docelowego | awk '{print $2}')
line1_3=$(echo $uprawnienia_pliku_docelowego | awk '{print $3}')
line2_1=$(printf "╰"; printf '%.0s─' $(seq 1 $ile_kresek); printf "► %s " "$2")
line2_2=$(echo $uprawnienia_pliku_docelowego | awk '{print $1}')

if compare-files $1 $2; then
  $INSPECT && line2_5=" [copy/y/N]"
  printf "%s %-19s" "$line1_1" "$line1_2 $line1_3"
  printf " %s\n" "1=2"
  printf "%s%10s" "$line2_1" "$line2_2"
  printf "%13s" "$line2_5"

  if $INSPECT; then user_input; else printf "\n"; fi
else
  line2_5=" [copy/y/N]"
  printf "%s %-19s" "$line1_1" "$line1_2 $line1_3"
  [ -f "$1" ] && ([ -f "$2" ] && printf " %s\n" "1≠2" || printf " %s\n" "2∈Ø") || printf " %s\n" "1∈Ø"
  printf "%s%10s" "$line2_1" "$line2_2"
  printf "%13s" "$line2_5"

  user_input
fi

printf "${RESET}"

[ "$odpowiedz" == "y" ] && exit 1
[ "$odpowiedz" == "copy" ] && exit 2
exit 0
