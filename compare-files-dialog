#!/usr/bin/env bash

uprawnienia_pliku_docelowego="$(ls -l $2 --color=auto 2>/dev/null | awk '{print $1, $3, $4}')"
KOLOR="\033[38;5;153m"
RESET="\033[0m"

((${3:0} % 2 == 0)) && printf "${KOLOR}" || printf "${RESET}"

ile_kresek=$((110 - ${#2} - 3))
printf "│%s" "$1"; printf "\n╰"; printf '%.0s─' $(seq 1 $ile_kresek); printf "► %s " "$2"

compare-files $1 $2 && printf "%-20s %s\n" "$uprawnienia_pliku_docelowego" "1=2" && printf "${RESET}" && exit 0
printf "%-20s" "$uprawnienia_pliku_docelowego"
[ -f "$2" ] && printf " %s" "1≠2" || printf " %s" "2∈Ø"

printf " [C/yes/n]" # 'C' stands for 'Compare'
read -s odpowiedz
echo

printf "${RESET}"

[ "$odpowiedz" == "n" ] && exit 0
[ "$odpowiedz" == "y" ] && exit 2

exit 1
