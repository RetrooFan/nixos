#!/usr/bin/env bash

INSPECT=false
while getopts "i" flaga; do
  case "${flaga}" in
    i)
      INSPECT=true
      ;;
  esac
done
shift $((OPTIND - 1))

header() {
  printf "╭"; printf '%.0s─' $(seq 1 81); printf "┬"; printf '%.0s─' $(seq 1 25); printf "╮\n"
  printf "│ %-58s ──► %16s │ %s        %s\n" "Source file" "Destination file" "Dest. props" "Info │"
  printf "├"; printf '%.0s─' $(seq 1 81); printf "┼"; printf '%.0s─' $(seq 1 25); printf "┤\n"
}

user_input() {
  printf "${RESET} ${KOLOR}"
  read odpowiedz
  odpowiedz="${odpowiedz,,}"
}

plik_zrodlowy="${1/#$HOME/\~}"
plik_docelowy="${2/#$HOME/\~}"
uprawnienia_pliku_docelowego="$(ls -l $2 2>/dev/null | awk '{print $1, $3, $4}')"
((${3:0} % 2)) && KOLOR="\033[0m" || KOLOR="\033[38;5;111m"
CZERWONY="\e[1;31m"
RESET="\033[0m"
ile_kresek=$((80 - ${#plik_docelowy} - 2))
line1_1=$(printf "│ %-74s%5s" "$plik_zrodlowy" "$(( $3 + 1 ))/$4")
line1_2=$(echo $uprawnienia_pliku_docelowego | awk '{print $2}')
line1_3=$(echo $uprawnienia_pliku_docelowego | awk '{print $3}')
line2_1=$(
  (( $3 + 1 == $4 )) && printf "╰" || printf "├"
  printf '%.0s─' $(seq 1 $ile_kresek)
  printf "► %s" "$plik_docelowy"
)
line2_2=$(echo $uprawnienia_pliku_docelowego | awk '{print $1}')

[ $3 == 0 ] && header

printf "${KOLOR}"
if compare-files $1 $2; then
  $INSPECT && line2_5="[copy/y/N]"
  printf "%s │ %-19s " "$line1_1" "$line1_2 $line1_3"
  printf "%s\n" "1=2 │"
  printf "%s │ %-13s" "$line2_1" "$line2_2"
  printf "%10s %s" "$line2_5" "│"

  if $INSPECT; then user_input; else printf "\n"; fi
else
  line2_5="[copy/y/N]"
  printf "%s │ %-19s " "$line1_1" "$line1_2 $line1_3"
  printf "${CZERWONY}"
  [ -f "$1" ] && ([ -f "$2" ] && printf "%s" "1≠2" || printf "%s" "2∈Ø") || printf "%s" "1∈Ø"
  printf "${RESET}"
  printf "${KOLOR}"
  printf " │\n"
  printf "%s │ %-13s" "$line2_1" "$line2_2"
  printf "${CZERWONY}"
  printf "%10s" "$line2_5"
  printf "${KOLOR}"
  printf " │"

  user_input
fi
printf "${RESET}"

[ "$odpowiedz" == "y" ] && exit 1
[ "$odpowiedz" == "copy" ] && exit 2
exit 0
