#!/usr/bin/env bash

INSPECT=false
while getopts "i" flaga; do
  case "${flaga}" in
    i)
      INSPECT=true
      ;;
  esac
done
shift $((OPTIND - 1))

user_input() {
  printf $1
  printf "${RESET} ${KOLOR}"
  read odpowiedz
  odpowiedz="${odpowiedz,,}"
}

uprawnienia_pliku_docelowego="$(ls -l $2 --color=auto 2>/dev/null | awk '{print $1, $3, $4}')"
((${3:0} % 2)) && KOLOR="\033[0m" || KOLOR="\033[38;5;153m"
RESET="\033[0m"

ile_kresek=$((110 - ${#2} - 3))
printf "${KOLOR}"
printf "│%s\n" "$1"
printf "╰"; printf '%.0s─' $(seq 1 $ile_kresek); printf "► %s " "$2"
printf "%-20s" "$uprawnienia_pliku_docelowego"

if compare-files $1 $2; then
  printf " %s" "1=2"
  $INSPECT || printf "\n"
else
  [ -f "$2" ] && printf " %s" "1≠2" || printf " %s" "2∈Ø"

  user_input " [C/yes/n]" # 'C' stands for 'Compare'
fi

if $INSPECT; then
  user_input " [ENTER]"
fi

printf "${RESET}"

[ "$odpowiedz" == "c" ] && exit 1
[ "$odpowiedz" == "yes" ] && exit 2
$INSPECT && exit 1
exit 0
