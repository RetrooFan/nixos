#!/usr/bin/env bash

SILENT=false
while getopts "s" flaga; do
  case "${flaga}" in
    s)
      SILENT=true
      ;;
  esac
done
shift $((OPTIND - 1))

uprawnienia_pliku_docelowego="$(ls -l $2 --color=auto 2>/dev/null | awk '{print $1, $3, $4}')"

((${3:0} % 2 == 0)) && printf "\033[38;5;153m" || printf "\033[0m"

ile_kresek=$((110 - ${#2} - 2))
printf "│%s" "$1"; printf "\n╰"; printf '%.0s─' $(seq 1 $ile_kresek); printf "►%s " "$2"

compare-files $1 $2 && printf "%s %s\n" "$uprawnienia_pliku_docelowego" "1=2" && exit 0
printf "%s" "$uprawnienia_pliku_docelowego"
[ -f "$2" ] && printf " %s" "1≠2" || printf " %s" "2∈Ø"

if $SILENT; then
  printf " %s %s\n" "──►" "1=2"
else
  read -p " [ENTER]"
fi

exit 1
