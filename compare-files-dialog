#!/usr/bin/env bash

INSPECT=false
while getopts "i" flaga; do
  case "${flaga}" in
    i)
      INSPECT=true
      ;;
  esac
done
shift $((OPTIND - 1))

user_input() {
  printf " [copy/y/N]"
  printf "${RESET} ${KOLOR}"
  read odpowiedz
  odpowiedz="${odpowiedz,,}"
}

uprawnienia_pliku_docelowego="$(ls -l $2 --color=auto 2>/dev/null | awk '{print $1, $3, $4}')"
((${3:0} % 2)) && KOLOR="\033[0m" || KOLOR="\033[38;5;153m"
RESET="\033[0m"

ile_kresek=$((100 - ${#2} - 3))
printf "${KOLOR}"
printf "│%-94s%5s\n" "$1" "$(( $3 + 1 ))/$4"
printf "╰"; printf '%.0s─' $(seq 1 $ile_kresek); printf "► %s " "$2"
printf "%-26s" "$uprawnienia_pliku_docelowego"

if compare-files $1 $2; then
  printf " %s" "1=2"
  if $INSPECT; then user_input; else printf "\n"; fi
else
  [ -f "$2" ] && printf " %s" "1≠2" || printf " %s" "2∈Ø"
  user_input
fi

printf "${RESET}"

[ "$odpowiedz" == "y" ] && exit 1
[ "$odpowiedz" == "copy" ] && exit 2
exit 0
