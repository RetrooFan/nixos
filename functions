#!/usr/bin/env bash

compare-files() {
  HASH1=$(sha256sum $1 2>/dev/null | awk '{print $1}') &&
  HASH2=$(sha256sum $2 2>/dev/null | awk '{print $1}') &&

  if [ "$HASH1" != "$HASH2" ]; then
    if [ "$3" != "" ]; then
      echo "--------------------------------------------------"
      echo "|                                                |"
      echo "|          Pliki sa rozne lub ich brak!          |"; [ "$COMMAND" == "copy-config-to-home" ] &&
      echo "|    Uruchom polecenie 'copy-config-to-home'!    |"; [ "$COMMAND" == "copy-config-to-system" ] &&
      echo "|   Uruchom polecenie 'copy-config-to-system'!   |"
      echo "|                                                |"
      echo "--------------------------------------------------"

      printf "%-47s -> %-45s\n\n" "$1" "$2"
    fi

    return 2
  fi
}

header() {
  printf "╭"; printf '%.0s─' $(seq 1 81); printf "┬"; printf '%.0s─' $(seq 1 25); printf "╮\n"
  printf "│ %-58s ──► %16s │ %s        %s\n" "Source file" "Destination file" "Dest. props" "Info │"
  printf "├"; printf '%.0s─' $(seq 1 81); printf "┼"; printf '%.0s─' $(seq 1 25); printf "┤\n"
}

user-input() {
  printf "${RESET} ${KOLOR}"
  read odpowiedz
  odpowiedz="${odpowiedz,,}"
}

compare-files-dialog() {
  plik_zrodlowy="${1/#$HOME/\~}"
  plik_docelowy="${2/#$HOME/\~}"
  uprawnienia_pliku_docelowego="$(ls -l $2 2>/dev/null | awk '{print $1, $3, $4}')"
  ((${3:0} % 2)) && KOLOR="\033[0m" || KOLOR="\033[38;5;111m"
  CZERWONY="\e[1;31m"
  RESET="\033[0m"
  ile_kresek=$((80 - ${#plik_docelowy} - 2))
  line1_column1=$(printf "│ %-74s%5s" "$plik_zrodlowy" "$(( $3 + 1 ))/$4")
  props1=$(echo $uprawnienia_pliku_docelowego | awk '{print $2}')
  props2=$(echo $uprawnienia_pliku_docelowego | awk '{print $3}')
  line2_column1=$(
    (( $3 + 1 == $4 )) && printf "╰" || printf "├"
    printf '%.0s─' $(seq 1 $ile_kresek)
    printf "► %s" "$plik_docelowy"
  )
  props3=$(echo $uprawnienia_pliku_docelowego | awk '{print $1}')

  [ $3 == 0 ] && header

  printf "${KOLOR}"
  printf "%s │ %-19s " "$line1_column1" "$props1 $props2"
  line2=$(printf "%s │ %-13s" "$line2_column1" "$props3")
  if compare-files $1 $2; then
    $5 && read_hint="[copy/y/N]"
    printf "%s\n" "1=2 │"
    printf "$line2"
    printf "%10s" "$read_hint" && read_hint=""
    printf " │"

    if $5; then user-input; else printf "\n"; fi
  else
    read_hint="[copy/y/N]"
    printf "${CZERWONY}"
    [ -f "$1" ] && ([ -f "$2" ] && printf "%s" "1≠2" || printf "%s" "2∈Ø") || printf "%s" "1∈Ø"
    printf "${RESET}${KOLOR}"
    printf " │\n"
    printf "$line2"
    printf "${CZERWONY}"
    printf "%10s" "$read_hint" && read_hint=""
    printf "${KOLOR}"
    printf " │"

    user-input
  fi
  printf "${RESET}"

  [ "$odpowiedz" == "y" ] && odpowiedz="" && return 1
  [ "$odpowiedz" == "copy" ] && odpowiedz="" && return 2
  return 0
}
