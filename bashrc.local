#!/usr/bin/env bash
# ------------------------------------------------
# ------------------------------------------------

# export REPO_USER="user"
# export REPO_DIR="directory"

# if [ -f /etc/bashrc.local ]; then
#   source /etc/bashrc.local
# fi

# ------------------------------------------------
# ------------------------------------------------

source /etc/file-arrays

HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth

stty -ixon
export EDITOR=micro
export CURRENT_USER="$(whoami)"

alias -- grep='grep --color=auto'
alias -- fgrep='fgrep --color=auto'
alias -- egrep='egrep --color=auto'
alias -- l='ls -l'
alias -- ll='ls -lA'
alias -- mi='micro'

# ------------------------------------------------

case "$CURRENT_USER" in
  "root")
    PS1_COLOR='\[\033[01;31m\]';;
  "kristof")
    PS1_COLOR='\[\033[01;32m\]';;
  *)
    PS1_COLOR='\[\033[01;33m\]'
esac

PS1_FORMAT_END='\[\033[00m\]'
# PS1_PROMPT_TEXT='---->'
PS1_PROMPT_TEXT='\$\$\$\$\$'
PS1_USER_SPACES=`printf "%*s" $(expr 10 - ${#CURRENT_USER})`
# PS1_0='\[\e]0;\u@\h: \w\a\]${debian_chroot:+($debian_chroot)}'
PS1_USER="$PS1_COLOR\u$PS1_FORMAT_END"
PS1_HOST_SPACES=`printf "%*s" $(expr 15 - ${#HOSTNAME})`
PS1_HOST="\[\033[01;36m\]\h$PS1_FORMAT_END"
PS1_SHLVL="$PS1_COLOR$SHLVL$PS1_FORMAT_END"
PS1_PID="$$"
PS1_PATH="\[\033[01;34m\]\w$PS1_FORMAT_END"
PS1_PROMPT="$PS1_COLOR$PS1_PROMPT_TEXT$PS1_FORMAT_END -> "

PS1_INIT=$PS1
empty_lines=0

prompt() {
  # PS1_OLD='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]'
  # PS1=$(printf "\n%*s\r%s\n\$ " "$(tput cols)" "$(date)" "$PS1_OLD")

  PS1_DATE=$(date)
  printf -v PS1_DATE_LINE '%.0s─' $(seq -1 ${#PS1_DATE})

  printf -v PS1_CURRENT_PROCESS_LINE '%.0s─' $(seq -1 ${#PS1_PID})

  PS1_PWD="${PWD/#$HOME/\~}"
  printf -v PS1_PWD_LINE '%.0s─' $(seq -1 ${#PS1_PWD})

  printf -v PS1_SPACING '%.0s\n' $(seq 0 "$empty_lines")
  empty_lines=0

  PS1_HORIZONTAL_LINE="╰$PS1_DATE_LINE┴────────────┴─────────────────┴───┴$PS1_CURRENT_PROCESS_LINE┴$PS1_PWD_LINE┴"

  END_LINE_LENGTH=$((148 - ${#PS1_HORIZONTAL_LINE}))
  printf -v END_LINE '%.0s─' $(seq 1 $END_LINE_LENGTH)

  PS1_LINE1="│ $PS1_DATE │ $PS1_0$PS1_USER$PS1_USER_SPACES │ $PS1_HOST$PS1_HOST_SPACES │ $PS1_SHLVL │ $PS1_PID │ $PS1_PATH │"
  PS1_LINE2="$PS1_HORIZONTAL_LINE$END_LINE"
  PS1_LINE3="$PS1_SPACING$PS1_PROMPT"
  PS1="$PS1_LINE1\n$PS1_LINE2$PS1_LINE3"
}
PROMPT_COMMAND=prompt

# ------------------------------------------------

# SESSION_ID=`openssl rand -hex 4`
SESSION_ID=`hexdump -vn4 -e'4/1 "%02x"' /dev/urandom`
echo "# ----- | `date` | START | $SESSION_ID" >> $HISTFILE

# alias exit='nohup add-comment "$SESSION_ID" "$HISTFILE" >/dev/null 2>&1 & exit'
after_exit() {
  sleep 0.1 && echo "# ----- | `date` | END   | $SESSION_ID" >> "$HISTFILE" &
}
trap after_exit EXIT

# ------------------------------------------------

if [ "${#HOME_PATHS[@]}" != "${#SYSTEM_HOME_PATHS[@]}" ]; then
  echo
  echo "TABLICE MAJA ROZNE DLUGOSCI!"
  echo
else
  for ((i = 0; i < ${#HOME_PATHS[@]}; i++)); do
    compare-files -c copy-config-to-home ${SYSTEM_HOME_PATHS[$i]} ${HOME_PATHS[$i]}.etc
  done
fi

# ------------------------------------------------

git_pull() {
  [ "$CURRENT_USER" != "$REPO_USER" ] && return

  cd $REPO_DIR || return

  plik_z_data=".gitupdate"
  data_z_pliku=$(cat $plik_z_data)
  data_aktualna=$(date +%F)

  [ "$data_z_pliku" == "$data_aktualna" ] && return

  echo "git pull ..."
  git pull && echo $data_aktualna > $plik_z_data
}

INIT_DIR="$(pwd)"
git_pull
cd $INIT_DIR

# ------------------------------------------------
