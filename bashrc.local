#!/usr/bin/env bash
# ------------------------------------------------
# ------------------------------------------------

# export REPO_USER="user"
# export REPO_DIR="directory"

# if [ -f /etc/bashrc.local ]; then
#   source /etc/bashrc.local
# fi

# ------------------------------------------------
# ------------------------------------------------

HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth

stty -ixon
export EDITOR=micro
export CURRENT_USER="$(whoami)"
REPO_ROOT_PATHS=(
  $REPO_DIR/compare-files
  $REPO_DIR/copy-config-to-home
  $REPO_DIR/bashrc.root
  $REPO_DIR/bashrc.local
  $REPO_DIR/htoprc
  $REPO_DIR/nanorc
  $REPO_DIR/tmux.conf
)
SYSTEM_ROOT_PATHS=(
  /usr/local/bin/compare-files
  /usr/local/bin/copy-config-to-home
  /root/.bashrc.root
  /etc/bashrc.local
  /etc/htoprc
  /etc/nanorc
  /etc/tmux.conf
)
REPO_HOME_PATHS=(
  $REPO_DIR/homefiles/gitconfig
  $REPO_DIR/homefiles/tmux.conf
  $REPO_DIR/homefiles/inputrc
  $REPO_DIR/homefiles/lazygit.yml
  $REPO_DIR/homefiles/micro.bindings.json
  $REPO_DIR/homefiles/micro.settings.json
  $REPO_DIR/homefiles/vscode.settings.json
)
SYSTEM_HOME_PATHS=(
  /etc/homefiles/gitconfig
  /etc/homefiles/tmux.conf
  /etc/homefiles/inputrc
  /etc/homefiles/lazygit.yml
  /etc/homefiles/micro.bindings.json
  /etc/homefiles/micro.settings.json
  /etc/homefiles/vscode.settings.json
)
HOME_PATHS=(
  ~/.gitconfig
  ~/.tmux.conf
  ~/.inputrc
  ~/.config/lazygit/config.yml
  ~/.config/micro/bindings.json
  ~/.config/micro/settings.json
  ~/.config/Code/User/settings.json
)

export REPO_ROOT_PATHS_E=$(declare -p REPO_ROOT_PATHS)
export REPO_HOME_PATHS_E=$(declare -p REPO_HOME_PATHS)
export SYSTEM_ROOT_PATHS_E=$(declare -p SYSTEM_ROOT_PATHS)
export SYSTEM_HOME_PATHS_E=$(declare -p SYSTEM_HOME_PATHS)
export HOME_PATHS_E=$(declare -p HOME_PATHS)

alias -- grep='grep --color=auto'
alias -- fgrep='fgrep --color=auto'
alias -- egrep='egrep --color=auto'
alias -- l='ls -l'
alias -- ll='ls -lA'
alias -- mi='micro'

# ------------------------------------------------

case "$CURRENT_USER" in
  "root")
    PS1_COLOR='\[\033[01;31m\]';;
  "kristof")
    PS1_COLOR='\[\033[01;32m\]';;
  *)
    PS1_COLOR='\[\033[01;33m\]'
esac

PS1_FORMAT_END='\[\033[00m\]'
# PS1_PROMPT_TEXT='---->'
PS1_PROMPT_TEXT='\$\$\$\$\$'
PS1_SPACES=`printf "%*s" $(expr 10 - ${#CURRENT_USER})`
# PS1_0='\[\e]0;\u@\h: \w\a\]${debian_chroot:+($debian_chroot)}'
PS1_1="$PS1_COLOR\u$PS1_FORMAT_END"
PS1_2="\[\033[01;36m\]\h$PS1_FORMAT_END"
PS1_3="$PS1_COLOR$SHLVL$PS1_FORMAT_END"
PS1_4="$$"
PS1_5="\[\033[01;34m\]\w$PS1_FORMAT_END"
PS1_6="----------------------------------------------------------------------------------------------------------------------------------------------------"
PS1_PROMPT="$PS1_COLOR$PS1_PROMPT_TEXT$PS1_FORMAT_END -> "

PS1_INIT=$PS1
empty_lines=0

prompt() {
  # PS1_OLD='\[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]'
  # PS1=$(printf "\n%*s\r%s\n\$ " "$(tput cols)" "$(date)" "$PS1_OLD")

  printf -v PS1_7 '%.0s\n' $(seq 0 "$empty_lines")
  empty_lines=0

  PS1="| `date` | $PS1_0$PS1_1$PS1_SPACES | $PS1_2 | $PS1_3 | $PS1_4 | $PS1_5 |\n$PS1_6$PS1_7$PS1_PROMPT"
}
PROMPT_COMMAND=prompt

# ------------------------------------------------

# SESSION_ID=`openssl rand -hex 4`
SESSION_ID=`hexdump -vn4 -e'4/1 "%02x"' /dev/urandom`
echo "# ----- | `date` | START | $SESSION_ID" >> $HISTFILE

# alias exit='nohup add-comment "$SESSION_ID" "$HISTFILE" >/dev/null 2>&1 & exit'
after_exit() {
  sleep 0.1 && echo "# ----- | `date` | END   | $SESSION_ID" >> "$HISTFILE" &
}
trap after_exit EXIT

# ------------------------------------------------

if [ "${#HOME_PATHS[@]}" != "${#SYSTEM_HOME_PATHS[@]}" ]; then
  echo
  echo "TABLICE MAJA ROZNE DLUGOSCI!"
  echo
else
  for ((i = 0; i < ${#HOME_PATHS[@]}; i++)); do
    compare-files -c copy-config-to-home ${SYSTEM_HOME_PATHS[$i]} ${HOME_PATHS[$i]}.etc
  done
fi

# ------------------------------------------------

git_pull() {
  [ "$CURRENT_USER" != "$REPO_USER" ] && return

  cd $REPO_DIR || return

  plik_z_data=".gitupdate"
  data_z_pliku=$(cat $plik_z_data)
  data_aktualna=$(date +%F)

  [ "$data_z_pliku" == "$data_aktualna" ] && return

  echo "git pull ..."
  git pull && echo $data_aktualna > $plik_z_data
}

INIT_DIR="$(pwd)"
git_pull
cd $INIT_DIR

# ------------------------------------------------
