#!/usr/bin/env bash
# ------------------------------------------------
# /etc/bash.bashrc -------------------------------

# export REPO_USER=""
# export REPO_DIR="directory"

# if [ -f /etc/bashrc.local ]; then
#   source /etc/bashrc.local
# fi

# /etc/bash.bashrc -------------------------------
# ------------------------------------------------

HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth

stty -ixon
export EDITOR=micro

alias -- grep='grep --color=auto'
alias -- fgrep='fgrep --color=auto'
alias -- egrep='egrep --color=auto'
alias -- l='ls -l'
alias -- ll='ls -lA'
alias -- mi='micro'

# ------------------------------------------------

# shellcheck disable=SC1091
[ -f /etc/sources/set-prompt ] && source /etc/sources/set-prompt

# ------------------------------------------------

# shellcheck disable=SC1091
[ -f /etc/sources/set-exit-action ] && source /etc/sources/set-exit-action

# ------------------------------------------------

[ -f /etc/scripts/check-for-home-files ] && /etc/scripts/check-for-home-files

# ------------------------------------------------

[ -f /etc/scripts/git-pull ] && /etc/scripts/git-pull

# ------------------------------------------------
