#!/usr/bin/env bash
# ------------------------------------------------
# /etc/bash.bashrc -------------------------------

# export EDITOR=micro
# export REPO_USER=""
# export REPO_DIR="directory"

# if [ -f /etc/bashrc.local ]; then
#   source /etc/bashrc.local
# fi

# /etc/bash.bashrc -------------------------------
# ------------------------------------------------

[ -z "$PS1" ] && return

HISTSIZE=20000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth

shopt -s histappend
shopt -s checkwinsize
command -v stty 1>/dev/null && stty -ixon

alias -- grep='grep --color=auto'
alias -- fgrep='fgrep --color=auto'
alias -- egrep='egrep --color=auto'
alias -- l='ls -l'
alias -- ll='ls -lA'
alias -- mi='micro'

# ------------------------------------------------

# shellcheck disable=SC1091
[ -f /etc/sources/set-histfile ] && source /etc/sources/set-histfile

# shellcheck disable=SC1091
[ -f /etc/sources/set-exit-action ] && source /etc/sources/set-exit-action

# shellcheck disable=SC1091
[ -f /etc/sources/set-prompt ] && source /etc/sources/set-prompt

# ------------------------------------------------

[ -f /etc/scripts/check-for-home-files ] && /etc/scripts/check-for-home-files

[ -f /etc/scripts/git-pull ] && /etc/scripts/git-pull

# ------------------------------------------------

command -v direnv 1>/dev/null && eval "$(direnv hook bash)"

# ------------------------------------------------
