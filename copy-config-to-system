#!/usr/bin/env bash
set -euo pipefail

[ "$(id -u)" != 0 ] && echo "This script must be run as root!" && exit 1
[ -f "$REPO_DIR/file-paths" ]

# shellcheck disable=SC1091
source "$REPO_DIR"/file-paths || exit 1

if [ ${#ROOT_SCRIPT_INDEXES[@]} != ${#REPO_ROOT_PATHS[@]} ] ||
   [ ${#ROOT_SCRIPT_INDEXES[@]} != ${#SYSTEM_ROOT_PATHS[@]} ] ||
   [ ${#HOME_SCRIPT_INDEXES[@]} != ${#REPO_HOME_PATHS[@]} ] ||
   [ ${#HOME_SCRIPT_INDEXES[@]} != ${#SYSTEM_HOME_PATHS[@]} ]; then
  echo "TABLICE MAJA ROZNE DLUGOSCI!"; exit 0
fi

INSPECT=false
while getopts "i" flaga; do
  case "${flaga}" in
    i)
      INSPECT=true
      ;;
    *)
      echo "Invalid flag: -${flaga}" >&2
      exit 1
      ;;
  esac
done
shift $((OPTIND - 1))

mkdir -p /etc/homefiles/
mkdir -p /etc/scripts/
mkdir -p /etc/sources/

echo
size=${#REPO_ROOT_PATHS[@]}
for ((i = 0; i < size; i++)); do
  "$REPO_DIR"/scripts/compare-and-copy-files "${REPO_ROOT_PATHS[$i]}"    "${SYSTEM_ROOT_PATHS[$i]}"    "$i" "$size" "$INSPECT"
  [ -f "${SYSTEM_ROOT_PATHS[$i]}" ] && ${ROOT_SCRIPT_INDEXES[$i]} && chmod a+x "${SYSTEM_ROOT_PATHS[$i]}"
done
echo

size=${#REPO_HOME_PATHS[@]}
for ((i = 0; i < size; i++)); do
  "$REPO_DIR"/scripts/compare-and-copy-files "${REPO_HOME_PATHS[$i]}"    "${SYSTEM_HOME_PATHS[$i]}"    "$i" "$size" "$INSPECT"
done
echo

exit 0
