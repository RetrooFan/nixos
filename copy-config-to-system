#!/usr/bin/env bash

INSPECT=false
while getopts "i" flaga; do
  case "${flaga}" in
    i)
      INSPECT=true
      ;;
  esac
done
shift $((OPTIND - 1))

source $(dirname "${BASH_SOURCE[0]}")/file-arrays

eval "$REPO_ROOT_PATHS_E"
eval "$REPO_HOME_PATHS_E"
eval "$SYSTEM_ROOT_PATHS_E"
eval "$SYSTEM_HOME_PATHS_E"

if [ "${#REPO_ROOT_PATHS[@]}" != "${#SYSTEM_ROOT_PATHS[@]}" -o "${#REPO_HOME_PATHS[@]}" != "${#SYSTEM_HOME_PATHS[@]}" ]; then
  echo
  echo "TABLICE MAJA ROZNE DLUGOSCI!"
  echo

  exit 0
fi

echo
for ((i = 0; i < ${#REPO_ROOT_PATHS[@]}; i++)); do
  compare-files-dialog        ${REPO_ROOT_PATHS[$i]} ${SYSTEM_ROOT_PATHS[$i]} ${i}
  result=$?

  [ $result != 0 ] && $EDITOR ${REPO_ROOT_PATHS[$i]} ${SYSTEM_ROOT_PATHS[$i]}
  ((i < 3)) && chmod a+x                             ${SYSTEM_ROOT_PATHS[$i]}
done
echo

mkdir -p /etc/homefiles/
for ((i = 0; i < ${#REPO_HOME_PATHS[@]}; i++)); do
  compare-files-dialog        ${REPO_HOME_PATHS[$i]} ${SYSTEM_HOME_PATHS[$i]} ${i}
  result=$?

  [ $result != 0 ] && $EDITOR ${REPO_HOME_PATHS[$i]} ${SYSTEM_HOME_PATHS[$i]}
done
echo
