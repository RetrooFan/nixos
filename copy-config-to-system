#!/usr/bin/env bash

eval "$REPO_ROOT_PATHS_E"
eval "$REPO_HOME_PATHS_E"
eval "$SYSTEM_ROOT_PATHS_E"
eval "$SYSTEM_HOME_PATHS_E"

if [ "${#REPO_ROOT_PATHS[@]}" != "${#SYSTEM_ROOT_PATHS[@]}" -o "${#REPO_HOME_PATHS[@]}" != "${#SYSTEM_HOME_PATHS[@]}" ]; then
  echo
  echo "TABLICE MAJA ROZNE DLUGOSCI!"
  echo

  exit 0
fi

porownaj() {
  uprawnienia_pliku_docelowego="$(ls -l $2 --color=auto 2>/dev/null | awk '{print $1, $3, $4}')"

  printf "%-55s -> %-40s" "$1" "$2"
  compare-files $1 $2 && printf "%-21s%-6s\n" "$uprawnienia_pliku_docelowego" "1==2" && return
  printf "%-21s" "$uprawnienia_pliku_docelowego"
  [ -f "$2" ] && printf "%-6s" "1!=2" || printf "%-10s" "2 ∈ Ø"

  read -p "[ENTER]"

  micro $1 $2
}

echo
for ((i = 0; i < 2; i++)); do
  porownaj ${REPO_ROOT_PATHS[$i]} ${SYSTEM_ROOT_PATHS[$i]}
  chmod a+x                       ${SYSTEM_ROOT_PATHS[$i]}
done
echo

for ((i = 2; i < ${#REPO_ROOT_PATHS[@]}; i++)); do
  porownaj ${REPO_ROOT_PATHS[$i]} ${SYSTEM_ROOT_PATHS[$i]}
done
echo

mkdir -p /etc/homefiles/
for ((i = 0; i < ${#REPO_HOME_PATHS[@]}; i++)); do
  porownaj ${REPO_HOME_PATHS[$i]} ${SYSTEM_HOME_PATHS[$i]}
done
echo
