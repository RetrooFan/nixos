#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
[ "$(id -u)" != 0 ] && echo "This script must be run as root!" && exit 1

# shellcheck disable=SC1091
source "$script_dir"/file-paths || exit 1

INSPECT=false
while getopts "i" flaga; do
  case "${flaga}" in
    i)
      INSPECT=true
      ;;
    *)
      echo "Invalid flag: -${flaga}" >&2
      exit 1
      ;;
  esac
done
shift $((OPTIND - 1))

if [ ${#REPO_ROOT_PATHS[@]} != ${#SYSTEM_ROOT_PATHS[@]} ] || [ ${#REPO_HOME_PATHS[@]} != ${#SYSTEM_HOME_PATHS[@]} ]; then
  echo "TABLICE MAJA ROZNE DLUGOSCI!"; exit 0
fi

mkdir -p /etc/scripts/
mkdir -p /etc/sources/
mkdir -p /etc/homefiles/

echo
size=${#REPO_SCRIPTS_PATHS[@]}
for ((i = 0; i < size; i++)); do
  "$script_dir"/scripts/compare-and-copy-files "${REPO_SCRIPTS_PATHS[$i]}" "${SYSTEM_SCRIPTS_PATHS[$i]}" "$i" "$size" "$INSPECT"
  [ -f "${SYSTEM_SCRIPTS_PATHS[$i]}" ] && chmod a+x                        "${SYSTEM_SCRIPTS_PATHS[$i]}"
done
echo

size=${#REPO_ROOT_PATHS[@]}
for ((i = 0; i < size; i++)); do
  "$script_dir"/scripts/compare-and-copy-files "${REPO_ROOT_PATHS[$i]}"    "${SYSTEM_ROOT_PATHS[$i]}"    "$i" "$size" "$INSPECT"
done
echo

size=${#REPO_HOME_PATHS[@]}
for ((i = 0; i < size; i++)); do
  "$script_dir"/scripts/compare-and-copy-files "${REPO_HOME_PATHS[$i]}"    "${SYSTEM_HOME_PATHS[$i]}"    "$i" "$size" "$INSPECT"
done
echo
