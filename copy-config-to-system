#!/usr/bin/env bash

eval "$REPO_ROOT_PATHS_E"
eval "$REPO_HOME_PATHS_E"
eval "$SYSTEM_ROOT_PATHS_E"
eval "$SYSTEM_HOME_PATHS_E"

porownaj() {
  uprawnienia_pliku_docelowego="$(ls -l $2 --color=auto 2>/dev/null | awk '{print $1, $3, $4}')"

  printf "%-55s -> %-40s" "$1" "$2"

  compare-files $1 $2 &&
  printf "%-21s%-6s\n" "$uprawnienia_pliku_docelowego" "1==2" &&
  return

  printf "%-21s" "$uprawnienia_pliku_docelowego"

  [ -f "$2" ] &&
  printf "%-6s" "1!=2" ||
  printf "%-10s" "2 ∈ Ø"

  read -p "[ENTER]"

  micro $1 $2
}

echo

porownaj ${REPO_ROOT_PATHS[0]} ${SYSTEM_ROOT_PATHS[0]}
chmod a+x                      ${SYSTEM_ROOT_PATHS[0]}
porownaj ${REPO_ROOT_PATHS[1]} ${SYSTEM_ROOT_PATHS[1]}
chmod a+x                      ${SYSTEM_ROOT_PATHS[1]}

echo

porownaj ${REPO_ROOT_PATHS[2]} ${SYSTEM_ROOT_PATHS[2]}
porownaj ${REPO_ROOT_PATHS[3]} ${SYSTEM_ROOT_PATHS[3]}
porownaj ${REPO_ROOT_PATHS[4]} ${SYSTEM_ROOT_PATHS[4]}
porownaj ${REPO_ROOT_PATHS[5]} ${SYSTEM_ROOT_PATHS[5]}
porownaj ${REPO_ROOT_PATHS[6]} ${SYSTEM_ROOT_PATHS[6]}

echo

mkdir -p /etc/homefiles/

porownaj ${REPO_HOME_PATHS[0]} ${SYSTEM_HOME_PATHS[0]}
porownaj ${REPO_HOME_PATHS[1]} ${SYSTEM_HOME_PATHS[1]}
porownaj ${REPO_HOME_PATHS[2]} ${SYSTEM_HOME_PATHS[2]}
porownaj ${REPO_HOME_PATHS[3]} ${SYSTEM_HOME_PATHS[3]}
porownaj ${REPO_HOME_PATHS[4]} ${SYSTEM_HOME_PATHS[4]}
porownaj ${REPO_HOME_PATHS[5]} ${SYSTEM_HOME_PATHS[5]}
porownaj ${REPO_HOME_PATHS[6]} ${SYSTEM_HOME_PATHS[6]}

echo
