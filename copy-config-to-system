#!/usr/bin/env bash

source $REPO_DIR/file-arrays || exit 1

INSPECT=false
while getopts "i" flaga; do
  case "${flaga}" in
    i)
      INSPECT=true
      ;;
  esac
done
shift $((OPTIND - 1))

command -v "compare-files-dialog" &>/dev/null && compare_files_dialog="compare-files-dialog" || compare_files_dialog="$REPO_DIR/compare-files-dialog"

if [ "${#REPO_ROOT_PATHS[@]}" != "${#SYSTEM_ROOT_PATHS[@]}" -o "${#REPO_HOME_PATHS[@]}" != "${#SYSTEM_HOME_PATHS[@]}" ]; then
  echo
  echo "TABLICE MAJA ROZNE DLUGOSCI!"
  echo

  exit 0
fi

echo
size=${#REPO_ROOT_PATHS[@]}
for ((i = 0; i < $size; i++)); do
  if $INSPECT; then
    $compare_files_dialog -i  ${REPO_ROOT_PATHS[$i]}        ${SYSTEM_ROOT_PATHS[$i]} $i $size
  else
    $compare_files_dialog     ${REPO_ROOT_PATHS[$i]}        ${SYSTEM_ROOT_PATHS[$i]} $i $size
  fi
  result=$?

  [ $result == 1 ] && $EDITOR ${REPO_ROOT_PATHS[$i]}        ${SYSTEM_ROOT_PATHS[$i]}
  [ $result == 2 ] && cp      ${REPO_ROOT_PATHS[$i]}        ${SYSTEM_ROOT_PATHS[$i]}
  [ -f ${SYSTEM_ROOT_PATHS[$i]} ] && ((i < 3)) && chmod a+x ${SYSTEM_ROOT_PATHS[$i]}
done
echo

mkdir -p /etc/homefiles/
size=${#REPO_HOME_PATHS[@]}
for ((i = 0; i < $size; i++)); do
  if $INSPECT; then
    $compare_files_dialog -i  ${REPO_HOME_PATHS[$i]}        ${SYSTEM_HOME_PATHS[$i]} $i $size
  else
    $compare_files_dialog     ${REPO_HOME_PATHS[$i]}        ${SYSTEM_HOME_PATHS[$i]} $i $size
  fi
  result=$?

  [ $result == 1 ] && $EDITOR ${REPO_HOME_PATHS[$i]}        ${SYSTEM_HOME_PATHS[$i]}
  [ $result == 2 ] && cp      ${REPO_HOME_PATHS[$i]}        ${SYSTEM_HOME_PATHS[$i]}
done
echo
