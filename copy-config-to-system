#!/bin/bash

porownaj() {
  uprawnienia_pliku_docelowego="$(ls -l $2 --color=auto 2>/dev/null | awk '{print $1, $3, $4}')"

  printf "%-30s -> %-40s" "$1" "$2"

  compare-files $1 $2 &&
  printf "%-21s%-6s\n" "$uprawnienia_pliku_docelowego" "1==2" &&
  return

  printf "%-21s" "$uprawnienia_pliku_docelowego"

  [ -f "$2" ] &&
  printf "%-6s" "1!=2" ||
  printf "%-10s" "2 ∈ Ø"

  read -p "[ENTER]"

  micro $1 $2
}

cd "$(dirname "${BASH_SOURCE[0]}")"

printf "\n%s:\n\n" "$(pwd)"

porownaj compare-files       /usr/local/bin/compare-files
chmod a+x                    /usr/local/bin/compare-files
porownaj copy-config-to-home /usr/local/bin/copy-config-to-home
chmod a+x                    /usr/local/bin/copy-config-to-home

echo

porownaj bashrc.local        /etc/bashrc.local
porownaj htoprc              /etc/htoprc
porownaj lazygit.yml         /etc/lazygit.yml
porownaj nanorc              /etc/nanorc
porownaj tmux.conf           /etc/tmux.conf

echo

mkdir -p /etc/homefiles/

porownaj homefiles/bashrc.root         /root/.bashrc.root
porownaj homefiles/gitconfig           /etc/homefiles/gitconfig
porownaj homefiles/inputrc             /etc/homefiles/inputrc
porownaj homefiles/micro.bindings.json /etc/homefiles/micro.bindings.json
porownaj homefiles/micro.settings.json /etc/homefiles/micro.settings.json
porownaj homefiles/tmux.conf           /etc/homefiles/tmux.conf

echo
