#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")"

# shellcheck disable=SC1091
source file-paths || exit 1

[ ! -f /etc/scripts/compare-and-copy-files ] && $EDITOR "$REPO_DIR/scripts/compare-and-copy-files" /etc/scripts/compare-and-copy-files
[ ! -f /etc/scripts/compare-files-dialog ]   && $EDITOR "$REPO_DIR/scripts/compare-files-dialog"   /etc/scripts/compare-files-dialog
[ ! -f /etc/scripts/compare-files ]          && $EDITOR "$REPO_DIR/scripts/compare-files"          /etc/scripts/compare-files

([ -f /etc/scripts/compare-and-copy-files ]  && chmod a+x /etc/scripts/compare-and-copy-files) || (echo "Missing file"; exit 1)
([ -f /etc/scripts/compare-files-dialog ]    && chmod a+x /etc/scripts/compare-files-dialog)   || (echo "Missing file"; exit 1)
([ -f /etc/scripts/compare-files ]           && chmod a+x /etc/scripts/compare-files)          || (echo "Missing file"; exit 1)

INSPECT=false
while getopts "i" flaga; do
  case "${flaga}" in
    i)
      INSPECT=true
      ;;
    *)
      echo "Invalid flag: -${flaga}" >&2
      exit 1
      ;;
  esac
done
shift $((OPTIND - 1))

echo
if [ ${#REPO_ROOT_PATHS[@]} != ${#SYSTEM_ROOT_PATHS[@]} ] || [ ${#REPO_HOME_PATHS[@]} != ${#SYSTEM_HOME_PATHS[@]} ]; then
  echo "TABLICE MAJA ROZNE DLUGOSCI!"; echo; exit 0
fi

mkdir -p /etc/scripts/
size=${#REPO_SCRIPTS_PATHS[@]}
for ((i = 0; i < size; i++)); do
  /etc/scripts/compare-and-copy-files "$INSPECT" "${REPO_SCRIPTS_PATHS[$i]}" "${SYSTEM_SCRIPTS_PATHS[$i]}" "$i" "$size"
  [ -f "${SYSTEM_SCRIPTS_PATHS[$i]}" ] && chmod a+x                            "${SYSTEM_SCRIPTS_PATHS[$i]}"
done
echo

mkdir -p /etc/sources/
size=${#REPO_ROOT_PATHS[@]}
for ((i = 0; i < size; i++)); do
  /etc/scripts/compare-and-copy-files   "$INSPECT" "${REPO_ROOT_PATHS[$i]}"    "${SYSTEM_ROOT_PATHS[$i]}"    "$i" "$size"
done
echo

mkdir -p /etc/homefiles/
size=${#REPO_HOME_PATHS[@]}
for ((i = 0; i < size; i++)); do
  /etc/scripts/compare-and-copy-files   "$INSPECT" "${REPO_HOME_PATHS[$i]}"    "${SYSTEM_HOME_PATHS[$i]}"    "$i" "$size"
done
echo
