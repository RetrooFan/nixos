#!/bin/bash

porownaj() {
  echo

  docelowy_plik=$(ls $2 --color=always);

  printf "Nastepny plik: | %-40s -> %-40s\n" "$1" "$docelowy_plik"

  compare-nixos-files $1 $2 1 && printf "Pliki identyczne (sha256sum) !\n" && return;

  read -p "Naciśnij [ENTER], aby kontynuować ...";

  micro $1 $2;
}

porownaj copy-nixos-files    /usr/local/bin/copy-nixos-files
chmod a+x                    /usr/local/bin/copy-nixos-files
porownaj setup-nixos-files   /usr/local/bin/setup-nixos-files
chmod a+x                    /usr/local/bin/setup-nixos-files

porownaj bashrc.local        /etc/bashrc.local
porownaj gitconfig           /etc/gitconfig
porownaj htoprc              /etc/htoprc
porownaj inputrc.local       /etc/inputrc.local
porownaj lazygit.yml         /etc/lazygit.yml
porownaj micro.bindings.json /etc/micro.bindings.json
porownaj micro.settings.json /etc/micro.settings.json
# porownaj nanorc              /etc/nanorc
porownaj tmux.conf           /etc/tmux.conf

echo
