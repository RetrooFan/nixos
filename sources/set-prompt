#!/usr/bin/env bash

set_prompt() {
  local PS1_COLOR
  case "$CURRENT_USER" in
    "root")
      PS1_COLOR="\[\033[01;31m\]";;
    "kristof")
      PS1_COLOR="\[\033[01;32m\]";;
    *)
      PS1_COLOR="\[\033[01;33m\]";;
  esac

  local PS1_FORMAT_END="\[\033[00m\]"
  local PS1_DATE; PS1_DATE=$(date); (( ${#PS1_DATE} < 31 )) && PS1_DATE+=$(printf "%$((31 - ${#PS1_DATE}))s")
  local PS1_USER; PS1_USER=$(printf "%s%-10s%s" "$PS1_COLOR" "$CURRENT_USER" "$PS1_FORMAT_END")
  local PS1_SHLVL="$PS1_COLOR$SHLVL$PS1_FORMAT_END"
  local PS1_PID; PS1_PID=$(printf "%-8s" "$$")
  local PS1_PATH="\[\033[01;34m\]\w$PS1_FORMAT_END"
  local PS1_LINE1="│ $PS1_DATE │ $PS1_USER │ $PS1_SHLVL │ $PS1_PID │ $PS1_PATH │"

  local PS1_PWD="${PWD/#$HOME/\~}"
  local PS1_HORIZONTAL_LINE; PS1_HORIZONTAL_LINE=$(printf "╰%33s┴%12s┴%3s┴%10s┴─%${#PS1_PWD}s─┴" | sed "s/ /─/g")
  local PS1_END_LINE; PS1_END_LINE=$(printf "%$((148 - ${#PS1_HORIZONTAL_LINE}))s" | sed "s/ /─/g")
  local PS1_LINE2="$PS1_HORIZONTAL_LINE$PS1_END_LINE"

  local PS1_VERTICAL_SPACING; PS1_VERTICAL_SPACING=$(printf "%${empty_lines:-0}s" | sed "s/ /\n/g"; echo X)
  local PS1_PROMPT_TEXT="\\$\\$\\$\\$\\$"
  local PS1_PROMPT="$PS1_COLOR$PS1_PROMPT_TEXT$PS1_FORMAT_END -> "
  local PS1_LINE3="${PS1_VERTICAL_SPACING%X}$PS1_PROMPT"

  empty_lines=0
  PS1="$PS1_LINE1\n$PS1_LINE2\n$PS1_LINE3"
}

# shellcheck disable=SC2034
PS1_INIT="$PS1"
PROMPT_COMMAND=set_prompt
