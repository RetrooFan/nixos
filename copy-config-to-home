#!/usr/bin/env bash

LINKS=false
DELETE=false

while getopts "ld" flaga; do
  case "${flaga}" in
    l)
      LINKS=true
      ;;
    d)
      DELETE=true
      ;;
  esac
done

shift $((OPTIND - 1))

eval "$REPO_HOME_PATHS_E"
eval "$SYSTEM_HOME_PATHS_E"
eval "$HOME_PATHS_E"

mkdir -p ~/.config/micro/
mkdir -p ~/.config/Code/User/
mkdir -p ~/.config/lazygit

rm -f ${HOME_PATHS[0]}.etc
rm -f ${HOME_PATHS[1]}.etc
rm -f ${HOME_PATHS[2]}.etc
rm -f ${HOME_PATHS[3]}.etc
rm -f ${HOME_PATHS[4]}.etc
rm -f ${HOME_PATHS[5]}.etc
rm -f ${HOME_PATHS[6]}.etc

echo
echo "Nadpisano nastepujace pliki:"
cp ${SYSTEM_HOME_PATHS[1]} ${HOME_PATHS[0]}.etc && printf "%-35s -> %-40s\n" "${SYSTEM_HOME_PATHS[1]}" "${HOME_PATHS[0]}.etc"
cp ${SYSTEM_HOME_PATHS[2]} ${HOME_PATHS[1]}.etc && printf "%-35s -> %-40s\n" "${SYSTEM_HOME_PATHS[2]}" "${HOME_PATHS[1]}.etc"
cp ${SYSTEM_HOME_PATHS[3]} ${HOME_PATHS[2]}.etc && printf "%-35s -> %-40s\n" "${SYSTEM_HOME_PATHS[3]}" "${HOME_PATHS[2]}.etc"
cp ${SYSTEM_HOME_PATHS[4]} ${HOME_PATHS[3]}.etc && printf "%-35s -> %-40s\n" "${SYSTEM_HOME_PATHS[4]}" "${HOME_PATHS[3]}.etc"
cp ${SYSTEM_HOME_PATHS[5]} ${HOME_PATHS[4]}.etc && printf "%-35s -> %-40s\n" "${SYSTEM_HOME_PATHS[5]}" "${HOME_PATHS[4]}.etc"
cp ${SYSTEM_HOME_PATHS[6]} ${HOME_PATHS[5]}.etc && printf "%-35s -> %-40s\n" "${SYSTEM_HOME_PATHS[6]}" "${HOME_PATHS[5]}.etc"
cp ${SYSTEM_HOME_PATHS[7]} ${HOME_PATHS[6]}.etc && printf "%-35s -> %-40s\n" "${SYSTEM_HOME_PATHS[7]}" "${HOME_PATHS[6]}.etc"
echo

chmod 644 ${HOME_PATHS[0]}.etc
chmod 644 ${HOME_PATHS[1]}.etc
chmod 644 ${HOME_PATHS[2]}.etc
chmod 644 ${HOME_PATHS[3]}.etc
chmod 644 ${HOME_PATHS[4]}.etc
chmod 644 ${HOME_PATHS[5]}.etc
chmod 644 ${HOME_PATHS[6]}.etc

if $DELETE; then
  # rm -f ${HOME_PATHS[0]}
  rm -f ${HOME_PATHS[1]}
  rm -f ${HOME_PATHS[2]}
  rm -f ${HOME_PATHS[3]}
  # rm -f ${HOME_PATHS[4]}
  rm -f ${HOME_PATHS[5]}
  rm -f ${HOME_PATHS[6]}
fi

if [ "$CURRENT_USER" == "$REPO_USER" -o "$CURRENT_USER" == "root" ]; then
  [ ! -f ${HOME_PATHS[0]} ] && cp    ${REPO_HOME_PATHS[1]} ${HOME_PATHS[0]}
  [ ! -f ${HOME_PATHS[1]} ] && ln -s ${REPO_HOME_PATHS[2]} ${HOME_PATHS[1]}
  [ ! -f ${HOME_PATHS[2]} ] && ln -s ${REPO_HOME_PATHS[3]} ${HOME_PATHS[2]}
  [ ! -f ${HOME_PATHS[3]} ] && ln -s ${REPO_HOME_PATHS[4]} ${HOME_PATHS[3]}
  [ ! -f ${HOME_PATHS[4]} ] && cp    ${REPO_HOME_PATHS[5]} ${HOME_PATHS[4]}
  [ ! -f ${HOME_PATHS[5]} ] && ln -s ${REPO_HOME_PATHS[6]} ${HOME_PATHS[5]}
  [ ! -f ${HOME_PATHS[6]} ] && ln -s ${REPO_HOME_PATHS[7]} ${HOME_PATHS[6]}

  exit 0
fi

if $LINKS; then
  cpOrLn() { ln -s "$1" "$2"; }
else
  cpOrLn() { cp "$1" "$2"; }
fi

[ ! -f ${HOME_PATHS[0]} ] && cp     ${HOME_PATHS[0]}.etc ${HOME_PATHS[0]}
[ ! -f ${HOME_PATHS[1]} ] && cpOrLn ${HOME_PATHS[1]}.etc ${HOME_PATHS[1]}
[ ! -f ${HOME_PATHS[2]} ] && cpOrLn ${HOME_PATHS[2]}.etc ${HOME_PATHS[2]}
[ ! -f ${HOME_PATHS[3]} ] && cpOrLn ${HOME_PATHS[3]}.etc ${HOME_PATHS[3]}
[ ! -f ${HOME_PATHS[4]} ] && cp     ${HOME_PATHS[4]}.etc ${HOME_PATHS[4]}
[ ! -f ${HOME_PATHS[5]} ] && cpOrLn ${HOME_PATHS[5]}.etc ${HOME_PATHS[5]}
[ ! -f ${HOME_PATHS[6]} ] && cpOrLn ${HOME_PATHS[6]}.etc ${HOME_PATHS[6]}
