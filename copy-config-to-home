#!/usr/bin/env bash

source $REPO_DIR/file-arrays 2>/dev/null ||
  source /etc/file-arrays ||
  exit 1

DELETE=false
INSPECT=false
while getopts "di" flaga; do
  case "${flaga}" in
    d)
      DELETE=true
      ;;
    i)
      INSPECT=true
      ;;
  esac
done
shift $((OPTIND - 1))

command -v "compare-and-copy-files" &>/dev/null &&
  compare_and_copy_files="compare-and-copy-files" ||
  compare_and_copy_files="$REPO_DIR/compare-and-copy-files"

command -v "compare-files-dialog" &>/dev/null &&
  compare_files_dialog="compare-files-dialog" ||
  compare_files_dialog="$REPO_DIR/compare-files-dialog"

echo
if [ "${#HOME_PATHS[@]}" != "${#SYSTEM_HOME_PATHS[@]}" -o "${#HOME_PATHS[@]}" != "${#REPO_HOME_PATHS[@]}" ]; then
  echo "TABLICE MAJA ROZNE DLUGOSCI!"; echo; exit 0
fi

HOME_PATHS_etc=("${HOME_PATHS[@]/%/.etc}")

mkdir -p ~/.config/micro/
mkdir -p ~/.config/Code/User/
mkdir -p ~/.config/lazygit/
mkdir -p ~/.config/alacritty/
mkdir -p ~/.config/sublime-text/Packages/User/

size=${#SYSTEM_HOME_PATHS[@]}
for ((i = 0; i < $size; i++)); do
  $compare_and_copy_files $compare_files_dialog $INSPECT ${SYSTEM_HOME_PATHS[$i]} ${HOME_PATHS_etc[$i]} $i $size
  [ -f ${HOME_PATHS_etc[$i]} ] && chmod a=r ${HOME_PATHS_etc[$i]}
done
echo

if $DELETE; then
  for ((i = 2; i < ${#HOME_PATHS[@]}; i++)); do
    rm -f ${HOME_PATHS[$i]}
  done
fi

if [ "$CURRENT_USER" == "$REPO_USER" -o "$CURRENT_USER" == "root" ]; then
  for ((i = 0; i < ${#HOME_PATHS[@]}; i++)); do
    ((i < 2)) &&
    [ ! -f ${HOME_PATHS[$i]} ] && cp    ${REPO_HOME_PATHS[$i]} ${HOME_PATHS[$i]} ||
    [ ! -f ${HOME_PATHS[$i]} ] && ln -s ${REPO_HOME_PATHS[$i]} ${HOME_PATHS[$i]}
  done
else
  for ((i = 0; i < ${#HOME_PATHS[@]}; i++)); do
    [ ! -f ${HOME_PATHS[$i]} ] && cp    ${HOME_PATHS[$i]}.etc  ${HOME_PATHS[$i]}
  done
fi

size=${#HOME_PATHS_etc[@]}
for ((i = 0; i < $size; i++)); do
  $compare_and_copy_files $compare_files_dialog $INSPECT ${HOME_PATHS_etc[$i]} ${HOME_PATHS[$i]} $i $size
done
echo
