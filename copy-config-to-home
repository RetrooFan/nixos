#!/usr/bin/env bash

source $REPO_DIR/file-arrays 2>/dev/null || source /etc/file-arrays || exit 1

DELETE=false
INSPECT=false
while getopts "di" flaga; do
  case "${flaga}" in
    d)
      DELETE=true
      ;;
    i)
      INSPECT=true
      ;;
  esac
done
shift $((OPTIND - 1))

compare_files() {
  declare -n array0=$1
  declare -n array1=$2
  size=${#array0[@]}

  for ((i = 0; i < $size; i++)); do
    if $INSPECT; then
      $compare_files_dialog -i    ${array0[$i]} ${array1[$i]} $i $size
    else
      $compare_files_dialog       ${array0[$i]} ${array1[$i]} $i $size
    fi
    result=$?

    [ $result == 1 ] && $EDITOR   ${array0[$i]} ${array1[$i]}
    [ $result == 2 ] && cp        ${array0[$i]} ${array1[$i]}
    [ $3 ] && [ -f ${array1[$i]} ] && chmod a=r ${array1[$i]}
  done
}

command -v "compare-files-dialog" &>/dev/null && compare_files_dialog="compare-files-dialog" || compare_files_dialog="$REPO_DIR/compare-files-dialog"
HOME_PATHS_etc=("${HOME_PATHS[@]/%/.etc}")

if [ "${#HOME_PATHS[@]}" != "${#SYSTEM_HOME_PATHS[@]}" -o "${#HOME_PATHS[@]}" != "${#REPO_HOME_PATHS[@]}" ]; then
  echo
  echo "TABLICE MAJA ROZNE DLUGOSCI!"
  echo

  exit 0
fi

mkdir -p ~/.config/micro/
mkdir -p ~/.config/Code/User/
mkdir -p ~/.config/lazygit/
mkdir -p ~/.config/alacritty/
mkdir -p ~/.config/sublime-text/Packages/User/

echo
compare_files SYSTEM_HOME_PATHS HOME_PATHS_etc true
echo

if $DELETE; then
  for ((i = 2; i < ${#HOME_PATHS[@]}; i++)); do
    rm -f ${HOME_PATHS[$i]}
  done
fi

if [ "$CURRENT_USER" == "$REPO_USER" -o "$CURRENT_USER" == "root" ]; then
  for ((i = 0; i < ${#HOME_PATHS[@]}; i++)); do
    ((i < 2)) &&
    [ ! -f ${HOME_PATHS[$i]} ] && cp    ${REPO_HOME_PATHS[$i]} ${HOME_PATHS[$i]} ||
    [ ! -f ${HOME_PATHS[$i]} ] && ln -s ${REPO_HOME_PATHS[$i]} ${HOME_PATHS[$i]}
  done
else
  for ((i = 0; i < ${#HOME_PATHS[@]}; i++)); do
    [ ! -f ${HOME_PATHS[$i]} ] && cp    ${HOME_PATHS[$i]}.etc  ${HOME_PATHS[$i]}
  done
fi

compare_files HOME_PATHS_etc HOME_PATHS
echo
