#!/usr/bin/env bash

CLEAN=false
DELETE=false
LINKS=false
while getopts "cdl" flaga; do
  case "${flaga}" in
    c)
      CLEAN=true
      ;;
    d)
      DELETE=true
      ;;
    l)
      LINKS=true
      ;;
  esac
done
shift $((OPTIND - 1))

eval "$REPO_HOME_PATHS_E"
eval "$SYSTEM_HOME_PATHS_E"
eval "$HOME_PATHS_E"

if [ "${#HOME_PATHS[@]}" != "${#SYSTEM_HOME_PATHS[@]}" -o "${#HOME_PATHS[@]}" != "${#REPO_HOME_PATHS[@]}" ]; then
  echo
  echo "TABLICE MAJA ROZNE DLUGOSCI!"
  echo

  exit 0
fi

mkdir -p ~/.config/micro/
mkdir -p ~/.config/Code/User/
mkdir -p ~/.config/lazygit/
mkdir -p ~/.config/alacritty/
mkdir -p ~/.config/sublime-text/Packages/User/

echo
for ((i = 0; i < ${#HOME_PATHS[@]}; i++)); do
  compare-files-dialog -s ${SYSTEM_HOME_PATHS[$i]} ${HOME_PATHS[$i]}.etc ${i} ||
  cp ${SYSTEM_HOME_PATHS[$i]} ${HOME_PATHS[$i]}.etc
  chmod 644 ${HOME_PATHS[$i]}.etc
done
echo

if $DELETE; then
  for ((i = 2; i < ${#HOME_PATHS[@]}; i++)); do
    rm -f ${HOME_PATHS[$i]}
  done
fi

if [ "$CURRENT_USER" == "$REPO_USER" -o "$CURRENT_USER" == "root" ]; then
  for ((i = 0; i < 2; i++)); do
    [ ! -f ${HOME_PATHS[$i]} ] && cp    ${REPO_HOME_PATHS[$i]} ${HOME_PATHS[$i]}
  done

  for ((i = 2; i < ${#HOME_PATHS[@]}; i++)); do
    [ ! -f ${HOME_PATHS[$i]} ] && ln -s ${REPO_HOME_PATHS[$i]} ${HOME_PATHS[$i]}
  done
else
  if $LINKS; then
    cpOrLn() { ln -s "$1" "$2"; }
  else
    cpOrLn() { cp "$1" "$2"; }
  fi

  for ((i = 0; i < 2; i++)); do
    [ ! -f ${HOME_PATHS[$i]} ] && cp     ${HOME_PATHS[$i]}.etc ${HOME_PATHS[$i]}
  done

  for ((i = 2; i < ${#HOME_PATHS[@]}; i++)); do
    [ ! -f ${HOME_PATHS[$i]} ] && cpOrLn ${HOME_PATHS[$i]}.etc ${HOME_PATHS[$i]}
  done
fi

for ((i = 0; i < ${#HOME_PATHS[@]}; i++)); do
  if $CLEAN; then
    compare-files-dialog -s ${HOME_PATHS[$i]}.etc ${HOME_PATHS[$i]} ${i}
  else
    compare-files-dialog ${HOME_PATHS[$i]}.etc ${HOME_PATHS[$i]} ${i} ||
    $EDITOR              ${HOME_PATHS[$i]}.etc ${HOME_PATHS[$i]}
  fi
done
echo
