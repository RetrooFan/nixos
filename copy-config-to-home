#!/usr/bin/env bash

DELETE=false
INSPECT=false
while getopts "di" flaga; do
  case "${flaga}" in
    d)
      DELETE=true
      ;;
    i)
      INSPECT=true
      ;;
  esac
done
shift $((OPTIND - 1))

eval "$REPO_HOME_PATHS_E"
eval "$SYSTEM_HOME_PATHS_E"
eval "$HOME_PATHS_E"

if [ "${#HOME_PATHS[@]}" != "${#SYSTEM_HOME_PATHS[@]}" -o "${#HOME_PATHS[@]}" != "${#REPO_HOME_PATHS[@]}" ]; then
  echo
  echo "TABLICE MAJA ROZNE DLUGOSCI!"
  echo

  exit 0
fi

mkdir -p ~/.config/micro/
mkdir -p ~/.config/Code/User/
mkdir -p ~/.config/lazygit/
mkdir -p ~/.config/alacritty/
mkdir -p ~/.config/sublime-text/Packages/User/

echo
size=${#HOME_PATHS[@]}
for ((i = 0; i < $size; i++)); do
  if $INSPECT; then
    compare-files-dialog -i   ${SYSTEM_HOME_PATHS[$i]} ${HOME_PATHS[$i]}.etc $i $size
  else
    compare-files-dialog      ${SYSTEM_HOME_PATHS[$i]} ${HOME_PATHS[$i]}.etc $i $size
  fi
  result=$?

  [ $result == 1 ] && $EDITOR ${SYSTEM_HOME_PATHS[$i]} ${HOME_PATHS[$i]}.etc
  [ $result == 2 ] && cp      ${SYSTEM_HOME_PATHS[$i]} ${HOME_PATHS[$i]}.etc
  chmod u+r ${HOME_PATHS[$i]}.etc
done
echo

if $DELETE; then
  for ((i = 2; i < ${#HOME_PATHS[@]}; i++)); do
    rm -f ${HOME_PATHS[$i]}
  done
fi

if [ "$CURRENT_USER" == "$REPO_USER" -o "$CURRENT_USER" == "root" ]; then
  for ((i = 0; i < ${#HOME_PATHS[@]}; i++)); do
    ((i < 2)) &&
    [ ! -f ${HOME_PATHS[$i]} ] && cp     ${REPO_HOME_PATHS[$i]} ${HOME_PATHS[$i]} ||
    [ ! -f ${HOME_PATHS[$i]} ] && ln -s  ${REPO_HOME_PATHS[$i]} ${HOME_PATHS[$i]}
  done
else
  for ((i = 0; i < ${#HOME_PATHS[@]}; i++)); do
    [ ! -f ${HOME_PATHS[$i]} ] && cp ${HOME_PATHS[$i]}.etc ${HOME_PATHS[$i]}
  done
fi

size=${#HOME_PATHS[@]}
for ((i = 0; i < $size; i++)); do
  if $INSPECT; then
    compare-files-dialog -i   ${HOME_PATHS[$i]}.etc ${HOME_PATHS[$i]} $i $size
  else
    compare-files-dialog      ${HOME_PATHS[$i]}.etc ${HOME_PATHS[$i]} $i $size
  fi
  result=$?

  [ $result == 1 ] && $EDITOR ${HOME_PATHS[$i]}.etc ${HOME_PATHS[$i]}
  [ $result == 2 ] && cp      ${HOME_PATHS[$i]}.etc ${HOME_PATHS[$i]}
done
echo
