#!/usr/bin/env bash

LINKS=false
DELETE=false

while getopts "ld" flaga; do
  case "${flaga}" in
    l)
      LINKS=true
      ;;
    d)
      DELETE=true
      ;;
  esac
done

shift $((OPTIND - 1))

FILE1=~/.gitconfig
FILE2=~/.inputrc
FILE3=~/.config/micro/bindings.json
FILE4=~/.config/micro/settings.json
FILE5=~/.tmux.conf
FILE6=~/.config/Code/User/settings.json

mkdir -p ~/.config/micro/
mkdir -p ~/.config/Code/User/

rm -f $FILE1.etc
rm -f $FILE2.etc
rm -f $FILE3.etc
rm -f $FILE4.etc
rm -f $FILE5.etc
rm -f $FILE6.etc

echo
echo "Nadpisano nastepujace pliki:"
cp /etc/homefiles/gitconfig            $FILE1.etc && printf "%-35s -> %-40s\n" "/etc/homefiles/gitconfig"            "$FILE1.etc"
cp /etc/homefiles/inputrc              $FILE2.etc && printf "%-35s -> %-40s\n" "/etc/homefiles/inputrc"              "$FILE2.etc"
cp /etc/homefiles/micro.bindings.json  $FILE3.etc && printf "%-35s -> %-40s\n" "/etc/homefiles/micro.bindings.json"  "$FILE3.etc"
cp /etc/homefiles/micro.settings.json  $FILE4.etc && printf "%-35s -> %-40s\n" "/etc/homefiles/micro.settings.json"  "$FILE4.etc"
cp /etc/homefiles/tmux.conf            $FILE5.etc && printf "%-35s -> %-40s\n" "/etc/homefiles/tmux.conf"            "$FILE5.etc"
cp /etc/homefiles/vscode.settings.json $FILE6.etc && printf "%-35s -> %-40s\n" "/etc/homefiles/vscode.settings.json" "$FILE6.etc"
echo

chmod 644 $FILE1.etc
chmod 644 $FILE2.etc
chmod 644 $FILE3.etc
chmod 644 $FILE4.etc
chmod 644 $FILE5.etc
chmod 644 $FILE6.etc

if $DELETE; then
  rm -f $FILE1
  rm -f $FILE2
  rm -f $FILE3
  rm -f $FILE4
  rm -f $FILE5
  rm -f $FILE6
fi

if $LINKS; then
  cpOrLn() { ln -s "$1" "$2"; }
else
  cpOrLn() { cp "$1" "$2"; }
fi

[ ! -f $FILE1 ] && cpOrLn $FILE1.etc $FILE1
[ ! -f $FILE2 ] && cpOrLn $FILE2.etc $FILE2
[ ! -f $FILE3 ] && cpOrLn $FILE3.etc $FILE3
[ ! -f $FILE4 ] && cpOrLn $FILE4.etc $FILE4
[ ! -f $FILE5 ] && cpOrLn $FILE5.etc $FILE5
[ ! -f $FILE6 ] && cpOrLn $FILE6.etc $FILE6
