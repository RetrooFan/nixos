#!/usr/bin/env bash

FILE1=~/.gitconfig
FILE2=~/.inputrc
FILE3=~/.config/micro/bindings.json
FILE4=~/.config/micro/settings.json
FILE5=~/.tmux.conf

mkdir -p ~/.config/micro/

cp /etc/homefiles/gitconfig           $FILE1.bckp
cp /etc/homefiles/inputrc.local       $FILE2.bckp
cp /etc/homefiles/micro.bindings.json $FILE3.bckp
cp /etc/homefiles/micro.settings.json $FILE4.bckp
cp /etc/homefiles/tmux.conf.local     $FILE5.bckp

chmod 444 $FILE1.bckp
chmod 444 $FILE2.bckp
chmod 444 $FILE3.bckp
chmod 444 $FILE4.bckp
chmod 444 $FILE5.bckp

echo
echo "Nadpisano nastepujace pliki:"
echo $FILE1.bckp
echo $FILE2.bckp
echo $FILE3.bckp
echo $FILE4.bckp
echo $FILE5.bckp
echo

[ ! -f $FILE1 ] && cp $FILE1.bckp $FILE1
[ ! -f $FILE2 ] && cp $FILE2.bckp $FILE2
[ ! -f $FILE3 ] && cp $FILE3.bckp $FILE3
[ ! -f $FILE4 ] && cp $FILE4.bckp $FILE4
[ ! -f $FILE5 ] && cp $FILE5.bckp $FILE5
