#!/usr/bin/env bash

mkdir -p ~/.config/micro/

FILE1=~/.gitconfig.bckp
FILE2=~/.inputrc.bckp
FILE3=~/.config/micro/bindings.json.bckp
FILE4=~/.config/micro/settings.json.bckp
FILE5=~/.tmux.conf.bckp

cp /etc/gitconfig           $FILE1
cp /etc/inputrc.local       $FILE2
cp /etc/micro.bindings.json $FILE3
cp /etc/micro.settings.json $FILE4
cp /etc/tmux.conf.local     $FILE5

chmod 644 $FILE1
chmod 644 $FILE2
chmod 644 $FILE3
chmod 644 $FILE4
chmod 644 $FILE5

echo "Nadpisano nastepujace pliki:"
echo $FILE1
echo $FILE2
echo $FILE3
echo $FILE4
echo $FILE5

ln -s $FILE1 ~/.gitconfig
ln -s $FILE2 ~/.inputrc
ln -s $FILE3 ~/.config/micro/bindings.json
ln -s $FILE4 ~/.config/micro/settings.json
ln -s $FILE5 ~/.tmux.conf
