#!/usr/bin/env bash
set -euo pipefail

# shellcheck disable=SC1091
source /etc/file-paths || exit 1

DELETE=false
INSPECT=false
while getopts "di" flaga; do
  case "${flaga}" in
    d)
      DELETE=true
      ;;
    i)
      INSPECT=true
      ;;
    *)
      echo "Invalid flag: -${flaga}" >&2
      exit 1
      ;;
  esac
done
shift $((OPTIND - 1))

echo
if [ ${#HOME_PATHS[@]} != ${#SYSTEM_HOME_PATHS[@]} ] || [ ${#HOME_PATHS[@]} != ${#REPO_HOME_PATHS[@]} ]; then
  echo "TABLICE MAJA ROZNE DLUGOSCI!"; echo; exit 0
fi

mkdir -p ~/.config/micro/
mkdir -p ~/.config/Code/User/
mkdir -p ~/.config/lazygit/
mkdir -p ~/.config/alacritty/
mkdir -p ~/.config/sublime-text/Packages/User/

size=${#SYSTEM_HOME_PATHS[@]}
for ((i = 0; i < size; i++)); do
  /etc/scripts/compare-and-copy-files     "${SYSTEM_HOME_PATHS[$i]}" "${HOME_PATHS[$i]}.etc" "$i" "$size" "$INSPECT"
  [ -f "${HOME_PATHS[$i]}.etc" ] && chmod a=r                        "${HOME_PATHS[$i]}.etc"
done
echo

if $DELETE; then
  for ((i = 2; i < ${#HOME_PATHS[@]}; i++)); do
    rm -f "${HOME_PATHS[$i]}"
  done
fi

if [ "$CURRENT_USER" == "$REPO_USER" ] || [ "$CURRENT_USER" == "root" ]; then
  for ((i = 0; i < 2; i++)); do
    [ ! -f "${HOME_PATHS[$i]}" ] && cp    "${REPO_HOME_PATHS[$i]}"   "${HOME_PATHS[$i]}"
  done

  for ((i = 2; i < ${#HOME_PATHS[@]}; i++)); do
    [ ! -f "${HOME_PATHS[$i]}" ] && ln -s "${REPO_HOME_PATHS[$i]}"   "${HOME_PATHS[$i]}"
  done
else
  for ((i = 0; i < ${#HOME_PATHS[@]}; i++)); do
    [ ! -f "${HOME_PATHS[$i]}" ] && cp    "${HOME_PATHS[$i]}.etc"    "${HOME_PATHS[$i]}"
  done
fi

size=${#HOME_PATHS[@]}
for ((i = 0; i < size; i++)); do
  /etc/scripts/compare-and-copy-files     "${HOME_PATHS[$i]}.etc"    "${HOME_PATHS[$i]}"     "$i" "$size" "$INSPECT"
done
echo
