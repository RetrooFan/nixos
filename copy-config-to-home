#!/usr/bin/env bash
set -euo pipefail

[ -f "$REPO_DIR/file-paths" ]

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
user_level=true; [ "$script_dir" == "$REPO_DIR" ] || user_level=false

if $user_level; then
  # shellcheck disable=SC1091
  source "$REPO_DIR/file-paths"

  run_dir="$REPO_DIR"
else
  # shellcheck disable=SC1091
  source /etc/file-paths

  run_dir="/etc"
fi

if [ ${#HOME_SCRIPT_INDEXES[@]} != ${#REPO_HOME_PATHS[@]} ] ||
   [ ${#HOME_SCRIPT_INDEXES[@]} != ${#SYSTEM_HOME_PATHS[@]} ] ||
   [ ${#HOME_SCRIPT_INDEXES[@]} != ${#HOME_PATHS[@]} ]; then
  echo "TABLICE MAJA ROZNE DLUGOSCI!"; exit 0
fi

DELETE=false
INSPECT=false
while getopts "di" flaga; do
  case "${flaga}" in
    d)
      DELETE=true
      ;;
    i)
      INSPECT=true
      ;;
    *)
      echo "Invalid flag: -${flaga}" >&2
      exit 1
      ;;
  esac
done
shift $((OPTIND - 1))

mkdir -p ~/.config/alacritty/
mkdir -p ~/.config/Code/User/
mkdir -p ~/.config/lazygit/
mkdir -p ~/.config/micro/
mkdir -p ~/.config/sublime-text/Packages/User/

echo
size=${#SYSTEM_HOME_PATHS[@]}
for ((i = 0; i < size; i++)); do
  "$run_dir"/scripts/compare-and-copy-files "${SYSTEM_HOME_PATHS[$i]}" "${HOME_PATHS[$i]}.etc" "$i" "$size" "$INSPECT"
  [ -f "${HOME_PATHS[$i]}.etc" ] && chmod a-wx                         "${HOME_PATHS[$i]}.etc"
done
echo

if $DELETE; then
  for ((i = 2; i < ${#HOME_PATHS[@]}; i++)); do
    rm -f "${HOME_PATHS[$i]}"
  done
fi

if [ "$(whoami)" == "$REPO_USER" ]; then
  for ((i = 0; i < 2; i++)); do
    [ ! -f "${HOME_PATHS[$i]}" ] && cp      "${REPO_HOME_PATHS[$i]}"   "${HOME_PATHS[$i]}"
  done

  for ((i = 2; i < ${#HOME_PATHS[@]}; i++)); do
    [ ! -f "${HOME_PATHS[$i]}" ] && ln -s   "${REPO_HOME_PATHS[$i]}"   "${HOME_PATHS[$i]}"
  done
else
  for ((i = 0; i < ${#HOME_PATHS[@]}; i++)); do
    [ ! -f "${HOME_PATHS[$i]}" ] && cp      "${HOME_PATHS[$i]}.etc"    "${HOME_PATHS[$i]}"
    [ -f "${HOME_PATHS[$i]}" ]   && chmod ug+w                         "${HOME_PATHS[$i]}"
  done
fi

size=${#HOME_PATHS[@]}
for ((i = 0; i < size; i++)); do
  "$run_dir"/scripts/compare-and-copy-files "${HOME_PATHS[$i]}.etc"    "${HOME_PATHS[$i]}"     "$i" "$size" "$INSPECT"
  [ -f "${HOME_PATHS[$i]}" ] && ${HOME_SCRIPT_INDEXES[$i]} && chmod a+x "${HOME_PATHS[$i]}"
done
echo

exit 0
