#!/usr/bin/env bash
# ------------------------------------------------
# ------------------------------------------------

# if [ -f /root/bashrc.root ]; then
#   source /root/bashrc.root
# fi

# ------------------------------------------------
# ------------------------------------------------

source $REPO_DIR/functions   2>/dev/null || source /etc/functions
source $REPO_DIR/file-arrays 2>/dev/null || source /etc/file-arrays

if [ "${#REPO_ROOT_PATHS[@]}" != "${#SYSTEM_ROOT_PATHS[@]}" -o "${#REPO_HOME_PATHS[@]}" != "${#SYSTEM_HOME_PATHS[@]}" ]; then
  echo
  echo "TABLICE MAJA ROZNE DLUGOSCI!"
  echo
else
  for ((i = 0; i < ${#REPO_ROOT_PATHS[@]}; i++)); do
    compare-files ${REPO_ROOT_PATHS[$i]} ${SYSTEM_ROOT_PATHS[$i]} "copy-config-to-system"
  done

  for ((i = 0; i < ${#REPO_HOME_PATHS[@]}; i++)); do
    compare-files ${REPO_HOME_PATHS[$i]} ${SYSTEM_HOME_PATHS[$i]} "copy-config-to-system"
  done
fi
