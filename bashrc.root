NIXOS_REPO="/home/kristof/7nixos"

compare-nixos-files $NIXOS_REPO/compare-nixos-files /usr/local/bin/compare-nixos-files
compare-nixos-files $NIXOS_REPO/copy-nixos-files    /usr/local/bin/copy-nixos-files

compare-nixos-files $NIXOS_REPO/micro.bindings.json /etc/micro.bindings.json
compare-nixos-files $NIXOS_REPO/micro.settings.json /etc/micro.settings.json
compare-nixos-files $NIXOS_REPO/inputrc.local       /etc/inputrc.local
compare-nixos-files $NIXOS_REPO/gitconfig           /etc/gitconfig

compare-nixos-files $NIXOS_REPO/bashrc.local        /etc/bashrc.local
compare-nixos-files $NIXOS_REPO/bashrc.root         /etc/bashrc.root
compare-nixos-files $NIXOS_REPO/htoprc              /etc/htoprc
compare-nixos-files $NIXOS_REPO/lazygit.yml         /etc/lazygit.yml
compare-nixos-files $NIXOS_REPO/nanorc              /etc/nanorc
compare-nixos-files $NIXOS_REPO/tmux.conf           /etc/tmux.conf
