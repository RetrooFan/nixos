# ------------------------------------------------

eval "$REPO_ROOT_PATHS_E"
eval "$REPO_HOME_PATHS_E"
eval "$SYSTEM_ROOT_PATHS_E"
eval "$SYSTEM_HOME_PATHS_E"

for ((i = 0; i < ${#REPO_ROOT_PATHS[@]}; i++)); do
  compare-files -c copy-config-to-system ${REPO_ROOT_PATHS[$i]} ${SYSTEM_ROOT_PATHS[$i]}
done

for ((i = 0; i < ${#REPO_HOME_PATHS[@]}; i++)); do
  compare-files -c copy-config-to-system ${REPO_HOME_PATHS[$i]} ${SYSTEM_HOME_PATHS[$i]}
done
