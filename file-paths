#!/usr/bin/env bash
# shellcheck disable=SC2034

script_file="$(basename "${BASH_SOURCE[1]}")"
source_dir="$(dirname "${BASH_SOURCE[0]}")"
user_level=false; [ "$source_dir" == "/etc" ] || [ "${script_file}" == "copy-config-to-system" ] || user_level=true

if $user_level; then
  SYSTEM_HOME_DIR="$REPO_DIR"
else
  SYSTEM_HOME_DIR="/etc"
fi

# ------------------------------------------------

mkdir -p /etc/homefiles/
mkdir -p /etc/scripts/
mkdir -p /etc/sources/

ROOT_SCRIPT_INDEXES=(true true true true true true true false false false false false false false false false)

REPO_ROOT_PATHS=(
  "$REPO_DIR/scripts/check-for-home-files"
  "$REPO_DIR/scripts/check-for-root-files"
  "$REPO_DIR/scripts/compare-and-copy-files"
  "$REPO_DIR/scripts/compare-files"
  "$REPO_DIR/scripts/compare-files-dialog"
  "$REPO_DIR/scripts/git-pull"
  "$REPO_DIR/copy-config-to-home"
  "$REPO_DIR/sources/set-exit-action"
  "$REPO_DIR/sources/set-histfile"
  "$REPO_DIR/sources/set-prompt"
  "$REPO_DIR/bashrc.local"
  "$REPO_DIR/bashrc.root"
  "$REPO_DIR/file-paths"
  "$REPO_DIR/htoprc"
  "$REPO_DIR/nanorc"
  "$REPO_DIR/tmux.conf"
)

SYSTEM_ROOT_PATHS=(
  /etc/scripts/check-for-home-files
  /etc/scripts/check-for-root-files
  /etc/scripts/compare-and-copy-files
  /etc/scripts/compare-files
  /etc/scripts/compare-files-dialog
  /etc/scripts/git-pull
  /usr/local/bin/copy-config-to-home
  /etc/sources/set-exit-action
  /etc/sources/set-histfile
  /etc/sources/set-prompt
  /etc/bashrc.local
  /root/.bashrc.root
  /etc/file-paths
  /etc/htoprc
  /etc/nanorc
  /etc/tmux.conf
)

# ------------------------------------------------

mkdir -p ~/.config/alacritty/
mkdir -p ~/.config/Code/User/
mkdir -p ~/.config/lazygit/
mkdir -p ~/.config/micro/
mkdir -p ~/.config/sublime-text/Packages/User/
mkdir -p ~/.vscode/extensions/

HOME_SCRIPT_INDEXES=(false false false false false false false false false false false)

REPO_HOME_PATHS=(
  "$REPO_DIR/homefiles/gitconfig"
  "$REPO_DIR/homefiles/tmux.conf"
  "$REPO_DIR/homefiles/inputrc"
  "$REPO_DIR/homefiles/alacritty.toml"
  "$REPO_DIR/homefiles/lazygit.yml"
  "$REPO_DIR/homefiles/micro.bindings.json"
  "$REPO_DIR/homefiles/micro.settings.json"
  "$REPO_DIR/homefiles/sublime.json"
  "$REPO_DIR/homefiles/vscode.extensions.json"
  "$REPO_DIR/homefiles/vscode.keybindings.json"
  "$REPO_DIR/homefiles/vscode.settings.json"
)

SYSTEM_HOME_PATHS=(
  "$SYSTEM_HOME_DIR/homefiles/gitconfig"
  "$SYSTEM_HOME_DIR/homefiles/tmux.conf"
  "$SYSTEM_HOME_DIR/homefiles/inputrc"
  "$SYSTEM_HOME_DIR/homefiles/alacritty.toml"
  "$SYSTEM_HOME_DIR/homefiles/lazygit.yml"
  "$SYSTEM_HOME_DIR/homefiles/micro.bindings.json"
  "$SYSTEM_HOME_DIR/homefiles/micro.settings.json"
  "$SYSTEM_HOME_DIR/homefiles/sublime.json"
  "$SYSTEM_HOME_DIR/homefiles/vscode.extensions.json"
  "$SYSTEM_HOME_DIR/homefiles/vscode.keybindings.json"
  "$SYSTEM_HOME_DIR/homefiles/vscode.settings.json"
)

HOME_PATHS=(
  ~/.gitconfig
  ~/.tmux.conf
  ~/.inputrc
  ~/.config/alacritty/alacritty.toml
  ~/.config/lazygit/config.yml
  ~/.config/micro/bindings.json
  ~/.config/micro/settings.json
  ~/.config/sublime-text/Packages/User/Preferences.sublime-settings
  ~/.vscode/extensions/extensions.json
  ~/.config/Code/User/keybindings.json
  ~/.config/Code/User/settings.json
)

# ------------------------------------------------

if $user_level; then
  mkdir -p ~/.config/htop/
  mkdir -p ~/.scripts/
  mkdir -p ~/.sources/

  REPO_HOME_PATHS[1]="$REPO_DIR/tmux.conf"
  SYSTEM_HOME_PATHS[1]="$SYSTEM_HOME_DIR/tmux.conf"

  HOME_SCRIPT_INDEXES+=(true true true false false false false false false)

  REPO_HOME_PATHS+=(
    "$REPO_DIR/scripts/check-for-home-files"
    "$REPO_DIR/scripts/compare-files"
    "$REPO_DIR/scripts/git-pull"
    "$REPO_DIR/sources/set-exit-action"
    "$REPO_DIR/sources/set-histfile"
    "$REPO_DIR/sources/set-prompt"
    "$REPO_DIR/bashrc.local.nonroot"
    "$REPO_DIR/htoprc"
    "$REPO_DIR/nanorc"
  )

  SYSTEM_HOME_PATHS+=(
    "$SYSTEM_HOME_DIR/scripts/check-for-home-files"
    "$SYSTEM_HOME_DIR/scripts/compare-files"
    "$SYSTEM_HOME_DIR/scripts/git-pull"
    "$SYSTEM_HOME_DIR/sources/set-exit-action"
    "$SYSTEM_HOME_DIR/sources/set-histfile"
    "$SYSTEM_HOME_DIR/sources/set-prompt"
    "$SYSTEM_HOME_DIR/bashrc.local.nonroot"
    "$SYSTEM_HOME_DIR/htoprc"
    "$SYSTEM_HOME_DIR/nanorc"
  )

  HOME_PATHS+=(
    "$HOME/.scripts/check-for-home-files"
    "$HOME/.scripts/compare-files"
    "$HOME/.scripts/git-pull"
    "$HOME/.sources/set-exit-action"
    "$HOME/.sources/set-histfile"
    "$HOME/.sources/set-prompt"
    "$HOME/.bashrc.local"
    "$HOME/.config/htop/htoprc"
    "$HOME/.nanorc"
  )
fi

# ------------------------------------------------
