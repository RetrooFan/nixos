#!/usr/bin/env bash

REPO_SCRIPTS_PATHS=(
  $REPO_DIR/copy-config-to-home
  $REPO_DIR/scripts/compare-and-copy-files
)
SYSTEM_SCRIPTS_PATHS=(
  /usr/local/bin/copy-config-to-home
  /etc/scripts/compare-and-copy-files
)

REPO_ROOT_PATHS=(
  $REPO_DIR/bashrc.root
  $REPO_DIR/bashrc.local
  $REPO_DIR/file-paths
  $REPO_DIR/functions
  $REPO_DIR/htoprc
  $REPO_DIR/nanorc
  $REPO_DIR/tmux.conf
)
SYSTEM_ROOT_PATHS=(
  /root/.bashrc.root
  /etc/bashrc.local
  /etc/file-paths
  /etc/functions
  /etc/htoprc
  /etc/nanorc
  /etc/tmux.conf
)

REPO_HOME_PATHS=(
  $REPO_DIR/homefiles/gitconfig
  $REPO_DIR/homefiles/tmux.conf
  $REPO_DIR/homefiles/alacritty.toml
  $REPO_DIR/homefiles/inputrc
  $REPO_DIR/homefiles/lazygit.yml
  $REPO_DIR/homefiles/micro.bindings.json
  $REPO_DIR/homefiles/micro.settings.json
  $REPO_DIR/homefiles/sublime.json
  $REPO_DIR/homefiles/vscode.json
)
SYSTEM_HOME_PATHS=(
  /etc/homefiles/gitconfig
  /etc/homefiles/tmux.conf
  /etc/homefiles/alacritty.toml
  /etc/homefiles/inputrc
  /etc/homefiles/lazygit.yml
  /etc/homefiles/micro.bindings.json
  /etc/homefiles/micro.settings.json
  /etc/homefiles/sublime.json
  /etc/homefiles/vscode.json
)
HOME_PATHS=(
  ~/.gitconfig
  ~/.tmux.conf
  ~/.config/alacritty/alacritty.toml
  ~/.inputrc
  ~/.config/lazygit/config.yml
  ~/.config/micro/bindings.json
  ~/.config/micro/settings.json
  ~/.config/sublime-text/Packages/User/Preferences.sublime-settings
  ~/.config/Code/User/settings.json
)

[ -f $REPO_DIR/scripts/compare-and-copy-files ] &&
  compare_and_copy_files="$REPO_DIR/scripts/compare-and-copy-files" ||
  compare_and_copy_files="/etc/scripts/compare-and-copy-files"

[ -f $REPO_DIR/scripts/compare-files-dialog ] &&
  compare_files_dialog="$REPO_DIR/scripts/compare-files-dialog" ||
  compare_files_dialog="/etc/scripts/compare-files-dialog"
