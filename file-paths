#!/usr/bin/env bash
# shellcheck disable=SC2034

script_file="$(basename "${BASH_SOURCE[1]}")"
source_dir="$(dirname "${BASH_SOURCE[0]}")"
[ "$source_dir" == "/etc" ] || [ "${script_file}" == "copy-config-to-system" ]; system_level="$?"

if [ $system_level == 0 ]; then
  SYSTEM_HOME_DIR="/etc"
else
  SYSTEM_HOME_DIR="$REPO_DIR"
fi

# ------------------------------------------------

REPO_SCRIPTS_PATHS=(
  "$REPO_DIR/scripts/compare-and-copy-files"
  "$REPO_DIR/scripts/compare-files-dialog"
  "$REPO_DIR/scripts/compare-files"
  "$REPO_DIR/scripts/git-pull"
  "$REPO_DIR/scripts/check-for-home-files"
  "$REPO_DIR/scripts/check-for-root-files"
  "$REPO_DIR/copy-config-to-home"
)

SYSTEM_SCRIPTS_PATHS=(
  /etc/scripts/compare-and-copy-files
  /etc/scripts/compare-files-dialog
  /etc/scripts/compare-files
  /etc/scripts/git-pull
  /etc/scripts/check-for-home-files
  /etc/scripts/check-for-root-files
  /usr/local/bin/copy-config-to-home
)

# ------------------------------------------------

REPO_ROOT_PATHS=(
  "$REPO_DIR/sources/set-exit-action"
  "$REPO_DIR/sources/set-prompt"
  "$REPO_DIR/bashrc.root"
  "$REPO_DIR/bashrc.local"
  "$REPO_DIR/file-paths"
  "$REPO_DIR/htoprc"
  "$REPO_DIR/nanorc"
  "$REPO_DIR/tmux.conf"
)

SYSTEM_ROOT_PATHS=(
  /etc/sources/set-exit-action
  /etc/sources/set-prompt
  /root/.bashrc.root
  /etc/bashrc.local
  /etc/file-paths
  /etc/htoprc
  /etc/nanorc
  /etc/tmux.conf
)

# ------------------------------------------------

REPO_HOME_PATHS=(
  "$REPO_DIR/homefiles/gitconfig"
  "$REPO_DIR/homefiles/tmux.conf"
  "$REPO_DIR/homefiles/alacritty.toml"
  "$REPO_DIR/homefiles/inputrc"
  "$REPO_DIR/homefiles/lazygit.yml"
  "$REPO_DIR/homefiles/micro.bindings.json"
  "$REPO_DIR/homefiles/micro.settings.json"
  "$REPO_DIR/homefiles/sublime.json"
  "$REPO_DIR/homefiles/vscode.keybindings.json"
  "$REPO_DIR/homefiles/vscode.settings.json"
)

SYSTEM_HOME_PATHS=(
  "$SYSTEM_HOME_DIR/homefiles/gitconfig"
  "$SYSTEM_HOME_DIR/homefiles/tmux.conf"
  "$SYSTEM_HOME_DIR/homefiles/alacritty.toml"
  "$SYSTEM_HOME_DIR/homefiles/inputrc"
  "$SYSTEM_HOME_DIR/homefiles/lazygit.yml"
  "$SYSTEM_HOME_DIR/homefiles/micro.bindings.json"
  "$SYSTEM_HOME_DIR/homefiles/micro.settings.json"
  "$SYSTEM_HOME_DIR/homefiles/sublime.json"
  "$SYSTEM_HOME_DIR/homefiles/vscode.keybindings.json"
  "$SYSTEM_HOME_DIR/homefiles/vscode.settings.json"
)

HOME_PATHS=(
  ~/.gitconfig
  ~/.tmux.conf
  ~/.config/alacritty/alacritty.toml
  ~/.inputrc
  ~/.config/lazygit/config.yml
  ~/.config/micro/bindings.json
  ~/.config/micro/settings.json
  ~/.config/sublime-text/Packages/User/Preferences.sublime-settings
  ~/.config/Code/User/keybindings.json
  ~/.config/Code/User/settings.json
)

if [ $system_level != 0 ]; then
  REPO_HOME_PATHS[1]="$REPO_DIR/tmux.conf"
  SYSTEM_HOME_PATHS[1]="$SYSTEM_HOME_DIR/tmux.conf"

  REPO_HOME_PATHS+=("$REPO_DIR/htoprc")
  SYSTEM_HOME_PATHS+=("$SYSTEM_HOME_DIR/htoprc")
  HOME_PATHS+=("$HOME/.config/htop/htoprc")

  REPO_HOME_PATHS+=("$REPO_DIR/nanorc")
  SYSTEM_HOME_PATHS+=("$SYSTEM_HOME_DIR/nanorc")
  HOME_PATHS+=("$HOME/.nanorc")
fi

# ------------------------------------------------
