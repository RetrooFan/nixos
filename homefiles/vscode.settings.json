{
  "breadcrumbs.enabled": false,
  "chat.agent.enabled": true,
  "chat.viewSessions.orientation": "stacked",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.fontFamily": "'Fira Code', 'monospace', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 15,
  "editor.minimap.enabled": false,
  "editor.mouseWheelScrollSensitivity": 2.06,
  "editor.stickyScroll.enabled": false,
  "extensions.ignoreRecommendations": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  // "git.autofetch": true,
  // "git.enableSmartCommit": true,
  // "git.rebaseWhenSync": true,
  "git.enabled": false,
  "js/ts.preferences.importModuleSpecifier": "relative",
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "npm.packageManager": "npm",
  "prettier.tabWidth": 2,
  "telemetry.telemetryLevel": "all",
  "terminal.integrated.fontSize": 14,
  "terminal.integrated.persistentSessionReviveProcess": "onExitAndWindowClose",
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.tabs.enabled": false,
  "update.mode": "none",
  "update.showReleaseNotes": false,
  "window.commandCenter": false,
  "window.density.layout": "compact",
  "window.menuBarVisibility": "visible",
  "window.customTitleBarVisibility": "windowed",
  "window.title": "${appName}${separator}${profileName}${separator}${rootName}${separator}${activeEditorShort} ${dirty}",
  "window.titleBarStyle": "custom",
  "window.titleSeparator": " — ",
  "window.zoomLevel": 3,
  "window.zoomPerWindow": false,
  "workbench.activityBar.location": "top",
  "workbench.browser.showInTitleBar": true,
  "workbench.editor.useModal": "off",
  "workbench.iconTheme": "vscode-icons",
  "workbench.layoutControl.enabled": false,
  "workbench.settings.editor": "json",
  "workbench.sideBar.location": "right",
  "workbench.startupEditor": "none",
  "aws.telemetry": false,
  "aws.cloudformation.telemetry.enabled": false,
  "aws.resources.enabledResources": [
    "AWS::EC2::Subnet",
    "AWS::EC2::VPC",
    "AWS::S3::Bucket"
  ],
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform"
  },
}
